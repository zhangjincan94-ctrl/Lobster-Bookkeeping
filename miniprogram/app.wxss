page {
  background-color: #0b1617;
  color: #f2f7f5;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
  font-variant-numeric: tabular-nums;
}

.page,
.container {
  box-sizing: border-box;
  min-height: 100vh;
  background-color: #0b1617;
  background-image: linear-gradient(rgba(41, 65, 66, 0.16) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(41, 65, 66, 0.16) 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
}

.container {
  padding: 24rpx;
}

.card {
  box-sizing: border-box;
  background-color: #122526;
  border: 1rpx solid #294142;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  box-shadow: none;
}

button {
  border-radius: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
}

button::after {
  border: none;
}

.btn-primary,
.submit-btn,
.save-cost-btn {
  background-color: #00a9a5;
  color: #002b2a;
  border: 1rpx solid #5de6dc;
  border-radius: 6rpx;
  box-shadow: 0 0 12rpx rgba(93, 230, 220, 0.18);
}

.btn-secondary {
  background-color: #122526;
  color: #5de6dc;
  border: 1rpx solid #3c6867;
  border-radius: 6rpx;
}

.btn-share {
  background-color: #122526;
  color: #5de6dc;
  border: 1rpx solid #3c6867;
  border-radius: 6rpx;
}

.btn-danger {
  background-color: rgba(255, 104, 104, 0.08);
  color: #ff8c8c;
  border: 1rpx solid rgba(255, 104, 104, 0.55);
  border-radius: 6rpx;
}

.btn-small {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

.text-price {
  color: #ff765e;
  font-weight: 700;
}

.text-debt,
.text-danger {
  color: #ff8c8c;
  font-weight: 700;
}

.text-income,
.text-success {
  color: #4bce91;
  font-weight: 700;
}

.text-cost {
  color: #e7b447;
  font-weight: 700;
}

.text-muted {
  color: #a1b2b0;
}

.text-primary {
  color: #5de6dc;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 34rpx;
  padding: 2rpx 12rpx;
  border: 1rpx solid transparent;
  border-radius: 4rpx;
  font-size: 20rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
}

.tag-unpaid,
.tag-danger {
  background-color: rgba(255, 104, 104, 0.1);
  border-color: rgba(255, 104, 104, 0.35);
  color: #ff8c8c;
}

.tag-paid,
.tag-success,
.tag-delivered {
  background-color: rgba(75, 206, 145, 0.1);
  border-color: rgba(75, 206, 145, 0.35);
  color: #4bce91;
}

.tag-partial,
.tag-warning,
.tag-delivering {
  background-color: rgba(231, 180, 71, 0.1);
  border-color: rgba(231, 180, 71, 0.35);
  color: #e7b447;
}

.tag-pending {
  background-color: rgba(93, 230, 220, 0.1);
  border-color: rgba(93, 230, 220, 0.35);
  color: #5de6dc;
}

.tag-cancelled {
  background-color: #1b2829;
  border-color: #445554;
  color: #a1b2b0;
}

.form-input,
.form-textarea,
.modal-input,
.form-picker,
.modal-picker,
.date-picker,
.picker-item {
  color: #f2f7f5;
}

input::placeholder,
textarea::placeholder {
  color: #718381;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  padding: 80rpx 40rpx;
  box-sizing: border-box;
}

.empty-state .empty-icon {
  margin-bottom: 16rpx;
  color: #5de6dc;
  font-size: 56rpx;
}

.empty-state .empty-text {
  color: #a1b2b0;
  font-size: 26rpx;
}

.loading-tip {
  padding: 28rpx 0;
  color: #a1b2b0;
  font-size: 24rpx;
  text-align: center;
}

.modal-mask,
.source-modal-mask {
  background-color: rgba(0, 9, 10, 0.76);
}

.modal-content,
.source-modal-content,
.cost-modal {
  background-color: #122526;
  border: 1rpx solid #3c6867;
  color: #f2f7f5;
}

.modal-title,
.source-modal-title {
  color: #f2f7f5;
}

.modal-btn {
  background-color: transparent;
}

.modal-btn-cancel {
  color: #a1b2b0;
}

.modal-btn-confirm {
  color: #5de6dc;
}

.fab {
  background-color: #ff6246;
  border: 1rpx solid #ff967f;
  box-shadow: 0 0 20rpx rgba(255, 98, 70, 0.24);
}

.fab-icon {
  color: #1b1615;
}
