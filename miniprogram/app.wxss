/* ===== 主题变量：默认奶油橄榄，.theme-lilac 覆盖为灰紫 ===== */
page,
.theme-cream {
  --bg: #faf9f5;
  --surface: #ffffff;
  --surface-2: #f5f4ee;
  --border: #eae7dd;
  --border-strong: #dbd7c9;
  --text: #1c1b16;
  --text-muted: #7a776a;
  --text-faint: #a8a496;
  --primary: #3f4b31;
  --primary-rgb: 63, 75, 49;
  --primary-weak: #eceee4;
  --on-primary: #ffffff;
  --sale: #b04a3c;
  --sale-rgb: 176, 74, 60;
  --sale-weak: #f8ebe7;
  --purchase: #55703f;
  --purchase-rgb: 85, 112, 63;
  --purchase-weak: #edf2e6;
  --warn: #96702b;
  --warn-rgb: 150, 112, 43;
  --warn-weak: #f7f0e1;
  --mask-rgb: 28, 27, 22;
  --shadow: 0 1rpx 2rpx rgba(28, 27, 22, 0.05);
}

.theme-lilac {
  --bg: #f8f7fa;
  --surface: #ffffff;
  --surface-2: #f3f2f7;
  --border: #e8e6ee;
  --border-strong: #d6d3e0;
  --text: #17151c;
  --text-muted: #74707d;
  --text-faint: #a8a3b2;
  --primary: #6d5b9e;
  --primary-rgb: 109, 91, 158;
  --primary-weak: #f0edf7;
  --on-primary: #ffffff;
  --sale: #c0504d;
  --sale-rgb: 192, 80, 77;
  --sale-weak: #f9eceb;
  --purchase: #4d7a5f;
  --purchase-rgb: 77, 122, 95;
  --purchase-weak: #ecf2ee;
  --warn: #a07827;
  --warn-rgb: 160, 120, 39;
  --warn-weak: #f8f2e4;
  --mask-rgb: 23, 21, 28;
  --shadow: 0 1rpx 2rpx rgba(23, 21, 28, 0.04);
}

page {
  background-color: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
  font-variant-numeric: tabular-nums;
}

.page,
.container {
  box-sizing: border-box;
  min-height: 100vh;
  background-color: var(--bg);
}

.container {
  padding: 24rpx;
}

.card {
  box-sizing: border-box;
  background-color: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  box-shadow: var(--shadow);
}

button {
  border-radius: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
}

button::after {
  border: none;
}

.btn-primary,
.submit-btn,
.save-cost-btn {
  background-color: var(--primary);
  color: var(--on-primary);
  border: 1rpx solid var(--primary);
  border-radius: 6rpx;
  box-shadow: none;
}

.btn-secondary {
  background-color: var(--surface);
  color: var(--primary);
  border: 1rpx solid var(--border-strong);
  border-radius: 6rpx;
}

.btn-share {
  background-color: var(--surface);
  color: var(--primary);
  border: 1rpx solid var(--border-strong);
  border-radius: 6rpx;
}

.btn-danger {
  background-color: var(--sale-weak);
  color: var(--sale);
  border: 1rpx solid rgba(var(--sale-rgb), 0.4);
  border-radius: 6rpx;
}

.btn-small {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

.text-price {
  color: var(--sale);
  font-weight: 700;
}

.text-debt,
.text-danger {
  color: var(--sale);
  font-weight: 700;
}

.text-income,
.text-success {
  color: var(--purchase);
  font-weight: 700;
}

.text-cost {
  color: var(--warn);
  font-weight: 700;
}

.text-muted {
  color: var(--text-muted);
}

.text-primary {
  color: var(--primary);
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 34rpx;
  padding: 2rpx 12rpx;
  border: 1rpx solid transparent;
  border-radius: 4rpx;
  font-size: 20rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
}

.tag-unpaid,
.tag-danger {
  background-color: var(--sale-weak);
  border-color: rgba(var(--sale-rgb), 0.28);
  color: var(--sale);
}

.tag-paid,
.tag-success,
.tag-delivered {
  background-color: var(--purchase-weak);
  border-color: rgba(var(--purchase-rgb), 0.28);
  color: var(--purchase);
}

.tag-partial,
.tag-warning,
.tag-delivering {
  background-color: var(--warn-weak);
  border-color: rgba(var(--warn-rgb), 0.28);
  color: var(--warn);
}

.tag-pending {
  background-color: var(--primary-weak);
  border-color: rgba(var(--primary-rgb), 0.28);
  color: var(--primary);
}

.tag-cancelled {
  background-color: var(--surface-2);
  border-color: var(--border-strong);
  color: var(--text-muted);
}

.form-input,
.form-textarea,
.modal-input,
.form-picker,
.modal-picker,
.date-picker,
.picker-item {
  color: var(--text);
}

input::placeholder,
textarea::placeholder {
  color: var(--text-faint);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  padding: 80rpx 40rpx;
  box-sizing: border-box;
}

.empty-state .empty-icon {
  margin-bottom: 16rpx;
  color: var(--primary);
  font-size: 56rpx;
}

.empty-state .empty-text {
  color: var(--text-muted);
  font-size: 26rpx;
}

.loading-tip {
  padding: 28rpx 0;
  color: var(--text-muted);
  font-size: 24rpx;
  text-align: center;
}

.modal-mask,
.source-modal-mask {
  background-color: rgba(var(--mask-rgb), 0.45);
}

.modal-mask {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content,
.source-modal-content,
.cost-modal {
  background-color: var(--surface);
  border: 1rpx solid var(--border-strong);
  color: var(--text);
  box-shadow: 0 8rpx 32rpx rgba(var(--mask-rgb), 0.12);
}

.modal-title,
.source-modal-title {
  color: var(--text);
}

.modal-btn {
  background-color: transparent;
}

.modal-btn-cancel {
  color: var(--text-muted);
}

.modal-btn-confirm {
  color: var(--primary);
}

.fab {
  background-color: var(--primary);
  border: 1rpx solid var(--primary);
  box-shadow: 0 4rpx 16rpx rgba(var(--primary-rgb), 0.24);
}

.fab-icon {
  color: var(--on-primary);
}

.error-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 12rpx 0 16rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid rgba(var(--sale-rgb), 0.28);
  border-radius: 6rpx;
  background-color: var(--sale-weak);
}

.error-text {
  min-width: 0;
  flex: 1;
  color: var(--sale);
  font-size: 23rpx;
}

.error-retry {
  flex: 0 0 auto;
  padding: 4rpx 18rpx;
  border: 1rpx solid rgba(var(--sale-rgb), 0.4);
  border-radius: 4rpx;
  color: var(--sale);
  font-size: 23rpx;
}

.retry-btn {
  margin-top: 24rpx;
  padding: 24rpx 36rpx;
}

.load-more {
  padding: 26rpx;
  background-color: var(--surface);
  color: var(--primary);
  font-size: 26rpx;
}
