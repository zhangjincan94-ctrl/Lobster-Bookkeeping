.page {
  min-height: 100vh;
  padding-bottom: 146rpx;
}

.detail-card {
  margin: 16rpx 24rpx;
  padding: 22rpx 20rpx;
  border: 1rpx solid #294142;
  border-radius: 6rpx;
  background-color: #122526;
}

.card-title {
  margin-bottom: 10rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #294142;
  color: #5de6dc;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 58rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #21393a;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  flex-shrink: 0;
  color: #a1b2b0;
  font-size: 23rpx;
}

.info-value {
  overflow: hidden;
  margin-left: 24rpx;
  color: #f2f7f5;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 25rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.payment-action,
.delivery-action {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.delivery-action .btn-small + .btn-small {
  margin-left: 12rpx;
}

.remark-text {
  color: #d3dfdd;
  font-size: 26rpx;
  line-height: 1.65;
}

.payment-record,
.source-record {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 13rpx 0;
  border-bottom: 1rpx solid #21393a;
}

.payment-record:last-child,
.source-record:last-child {
  border-bottom: none;
}

.payment-record-left,
.source-record-left {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-right: 18rpx;
}

.payment-record-amount,
.source-record-cost {
  color: #4bce91;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 26rpx;
  font-weight: 700;
}

.payment-record-method,
.payment-record-time,
.source-record-meta {
  margin-top: 4rpx;
  color: #a1b2b0;
  font-size: 20rpx;
}

.source-record-name {
  color: #f2f7f5;
  font-size: 26rpx;
  font-weight: 700;
}

.source-record-cost {
  color: #e7b447;
}

.bottom-bar {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #294142;
  background-color: #122526;
}

.bottom-btn {
  flex: 1;
  min-height: 78rpx;
  box-sizing: border-box;
}

.modal-mask {
  position: fixed;
  z-index: 200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 630rpx;
  overflow: hidden;
  border-radius: 8rpx;
}

.modal-title {
  padding: 26rpx 24rpx 14rpx;
  color: #f2f7f5;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 29rpx;
  font-weight: 700;
  text-align: center;
}

.modal-body {
  padding: 10rpx 24rpx 20rpx;
}

.modal-field {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  border-bottom: 1rpx solid #294142;
}

.modal-field:last-child {
  border-bottom: none;
}

.modal-label {
  flex-shrink: 0;
  width: 154rpx;
  color: #a1b2b0;
  font-size: 24rpx;
}

.modal-input,
.modal-picker {
  flex: 1;
  min-height: 58rpx;
  box-sizing: border-box;
  padding: 8rpx 0;
  color: #f2f7f5;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 25rpx;
  line-height: 42rpx;
  text-align: right;
}

.modal-actions {
  display: flex;
  border-top: 1rpx solid #294142;
}

.modal-btn {
  flex: 1;
  padding: 22rpx 0;
  border-radius: 0;
  font-size: 27rpx;
}

.modal-btn-cancel {
  border-right: 1rpx solid #294142;
}
