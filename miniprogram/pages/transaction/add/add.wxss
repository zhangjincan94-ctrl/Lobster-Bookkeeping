.page {
  min-height: 100vh;
  padding-bottom: 148rpx;
}

.form-card {
  margin: 16rpx 24rpx;
  padding: 22rpx 20rpx;
  border: 1rpx solid #294142;
  border-radius: 6rpx;
  background-color: #122526;
}

.section-title {
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #294142;
  color: #5de6dc;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.form-item {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 78rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #21393a;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  flex-shrink: 0;
  width: 172rpx;
  color: #a1b2b0;
  font-size: 25rpx;
}

.form-input,
.form-textarea {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  padding: 10rpx 0;
  color: #f2f7f5;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 27rpx;
  text-align: right;
}

.form-textarea {
  min-height: 120rpx;
  text-align: left;
}

.form-picker {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
  padding: 10rpx 0;
  color: #f2f7f5;
  font-size: 27rpx;
}

.picker-arrow {
  margin-left: 10rpx;
  color: #5de6dc;
  font-size: 22rpx;
}

.form-item-buyer {
  z-index: 30;
}

.buyer-input-wrap {
  position: relative;
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.buyer-dropdown {
  position: absolute;
  z-index: 50;
  top: 100%;
  right: 0;
  left: 0;
  max-height: 320rpx;
  margin-top: 6rpx;
  border: 1rpx solid #3c6867;
  border-radius: 6rpx;
  background-color: #122526;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.35);
}

.buyer-dropdown-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  border-bottom: 1rpx solid #294142;
  color: #f2f7f5;
  font-size: 26rpx;
}

.buyer-dropdown-empty {
  padding: 22rpx;
  color: #a1b2b0;
  font-size: 23rpx;
  text-align: center;
}

.source-select-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0 16rpx;
  border-bottom: 1rpx solid #21393a;
}

.source-select-title {
  display: block;
  color: #f2f7f5;
  font-size: 27rpx;
  font-weight: 700;
}

.source-select-tip,
.source-empty {
  display: block;
  margin-top: 6rpx;
  color: #718381;
  font-size: 21rpx;
}

.source-select-btn,
.source-modal-close {
  margin: 0;
  padding: 12rpx 18rpx;
  border: 1rpx solid #5de6dc;
  border-radius: 4rpx;
  background-color: rgba(93, 230, 220, 0.1);
  color: #5de6dc;
  font-size: 23rpx;
}

.source-selected-card {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(231, 180, 71, 0.45);
  border-radius: 4rpx;
  background-color: rgba(231, 180, 71, 0.07);
}

.source-selected-info,
.source-option-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-right: 16rpx;
}

.source-name {
  color: #f2f7f5;
  font-size: 26rpx;
  font-weight: 700;
}

.source-meta {
  margin-top: 6rpx;
  color: #a1b2b0;
  font-size: 20rpx;
  line-height: 1.45;
}

.source-remove {
  color: #ff8c8c;
  font-size: 22rpx;
}

.total-amount {
  flex: 1;
  color: #5de6dc;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 36rpx;
  font-weight: 700;
  text-align: right;
}

.radio-group {
  display: flex;
  flex: 1;
  justify-content: flex-end;
}

.radio-item {
  display: flex;
  align-items: center;
  margin-left: 18rpx;
  color: #f2f7f5;
  font-size: 24rpx;
}

.source-modal-mask {
  position: fixed;
  z-index: 200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
}

.source-modal-content {
  width: 100%;
  max-height: 76vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 10rpx 10rpx 0 0;
}

.source-modal-title {
  margin-bottom: 16rpx;
  color: #f2f7f5;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.source-modal-empty {
  padding: 56rpx 0;
  color: #a1b2b0;
  font-size: 24rpx;
  text-align: center;
}

.source-option-list {
  max-height: 52vh;
}

.source-option-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #294142;
}

.source-option-select {
  color: #5de6dc;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 22rpx;
}

.source-modal-close {
  width: 100%;
  margin-top: 18rpx;
  padding: 18rpx 0;
  background-color: #00a9a5;
  color: #002b2a;
  font-size: 28rpx;
}

.submit-bar {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #294142;
  background-color: #122526;
}

.submit-btn {
  width: 100%;
  min-height: 82rpx;
  color: #002b2a;
  font-size: 29rpx;
}

.submit-btn[disabled] {
  border-color: #435756;
  background-color: #435756;
  color: #9eaeac;
  box-shadow: none;
}
