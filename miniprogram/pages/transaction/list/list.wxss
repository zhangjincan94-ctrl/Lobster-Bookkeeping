.page {
  min-height: 100vh;
  padding-bottom: 136rpx;
}

.filter-bar,
.range-filter,
.date-filter {
  box-sizing: border-box;
  border-bottom: 1rpx solid #294142;
  background-color: #122526;
}

.filter-bar {
  position: sticky;
  z-index: 10;
  top: 0;
  padding: 16rpx 24rpx;
}

.status-tabs {
  display: flex;
  white-space: nowrap;
}

.status-tab {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  box-sizing: border-box;
  margin-right: 12rpx;
  padding: 0 22rpx;
  border: 1rpx solid #294142;
  border-radius: 4rpx;
  color: #a1b2b0;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 21rpx;
}

.status-tab-active {
  border-color: #5de6dc;
  background-color: rgba(93, 230, 220, 0.1);
  color: #5de6dc;
}

.range-filter {
  display: flex;
  padding: 14rpx 24rpx;
}

.range-tab {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  margin-right: 10rpx;
  padding: 10rpx 0;
  border-bottom: 2rpx solid transparent;
  color: #a1b2b0;
  font-size: 23rpx;
  text-align: center;
}

.range-tab:last-child {
  margin-right: 0;
}

.range-tab-active {
  border-color: #5de6dc;
  color: #f2f7f5;
}

.date-filter {
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
}

.date-picker {
  min-width: 184rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid #294142;
  border-radius: 4rpx;
  background-color: #0b1e1f;
  color: #f2f7f5;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 21rpx;
  text-align: center;
}

.date-separator {
  margin: 0 12rpx;
  color: #718381;
  font-size: 22rpx;
}

.transaction-list {
  padding: 16rpx 24rpx;
}

.transaction-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 22rpx 20rpx;
  border: 1rpx solid #294142;
  border-left: 3rpx solid #5de6dc;
  border-radius: 4rpx;
  background-color: #122526;
}

.transaction-left {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-right: 20rpx;
}

.transaction-buyer {
  overflow: hidden;
  color: #f2f7f5;
  font-size: 29rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.transaction-sub {
  margin-top: 8rpx;
  color: #a1b2b0;
  font-size: 22rpx;
}

.transaction-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.transaction-amount {
  color: #f2f7f5;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 31rpx;
  font-weight: 700;
}

.transaction-paid-row {
  display: flex;
  margin-top: 8rpx;
  font-size: 19rpx;
}

.transaction-paid-row .text-success {
  margin-right: 10rpx;
}

.transaction-bottom-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.transaction-time {
  margin-right: 10rpx;
  color: #718381;
  font-size: 19rpx;
}

.fab {
  position: fixed;
  z-index: 100;
  right: 32rpx;
  bottom: 114rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 8rpx;
}

.fab-icon {
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 48rpx;
  line-height: 1;
}
