.page { min-height: 100vh; padding: 16rpx 24rpx 32rpx; }
.supplier-card, .stats-card, .action-bar, .purchase-item { border: 1rpx solid #294142; border-radius: 6rpx; background-color: #122526; }
.supplier-card { padding: 22rpx; border-color: #3c6867; }
.supplier-head, .supplier-row { display: flex; align-items: center; justify-content: space-between; }
.supplier-name { color: #f2f7f5; font-size: 34rpx; font-weight: 700; }
.supplier-edit, .supplier-call { color: #5de6dc; font-family: "SFMono-Regular", Consolas, monospace; font-size: 22rpx; }
.supplier-row { margin-top: 10rpx; }
.supplier-phone, .supplier-remark { color: #a1b2b0; font-size: 22rpx; }
.supplier-remark { display: block; margin-top: 12rpx; line-height: 1.45; }
.stats-card { margin-top: 16rpx; overflow: hidden; }
.stats-row { display: flex; }
.stats-item { display: flex; flex: 1; flex-direction: column; min-width: 0; padding: 20rpx 14rpx; border-right: 1rpx solid #294142; }
.stats-item:last-child { border-right: none; }
.stats-value { overflow: hidden; color: #f2f7f5; font-family: "SFMono-Regular", Consolas, monospace; font-size: 27rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.stats-label { margin-top: 8rpx; color: #a1b2b0; font-size: 19rpx; }
.stats-foot { padding: 12rpx 14rpx; border-top: 1rpx solid #294142; color: #718381; font-size: 20rpx; }
.action-bar { display: flex; gap: 12rpx; margin-top: 16rpx; padding: 16rpx; }
.action-btn { flex: 1; min-height: 70rpx; border: 1rpx solid #3c6867; border-radius: 4rpx; background-color: transparent; color: #5de6dc; font-size: 25rpx; line-height: 68rpx; }
.action-btn-primary { border-color: #e7b447; background-color: rgba(231, 180, 71, 0.08); color: #e7b447; }
.section-header { margin-top: 26rpx; margin-bottom: 14rpx; padding-bottom: 10rpx; border-bottom: 1rpx solid #294142; }
.section-title { color: #5de6dc; font-family: "SFMono-Regular", Consolas, monospace; font-size: 21rpx; letter-spacing: 2rpx; }
.purchase-item { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 12rpx; padding: 20rpx; border-left: 3rpx solid #e7b447; }
.purchase-left { display: flex; flex: 1; flex-direction: column; min-width: 0; margin-right: 16rpx; }
.purchase-type { color: #f2f7f5; font-size: 26rpx; font-weight: 700; }
.purchase-sub, .purchase-time { margin-top: 6rpx; color: #a1b2b0; font-size: 20rpx; }
.purchase-right { display: flex; flex-direction: column; align-items: flex-end; }
.purchase-amount { color: #f2f7f5; font-family: "SFMono-Regular", Consolas, monospace; font-size: 28rpx; font-weight: 700; }
.purchase-bottom-row { display: flex; align-items: center; margin-top: 10rpx; }
.modal-mask { position: fixed; z-index: 200; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; }
.modal-content { width: 630rpx; overflow: hidden; border-radius: 8rpx; }
.modal-title { padding: 26rpx 24rpx 14rpx; color: #f2f7f5; font-family: "SFMono-Regular", Consolas, monospace; font-size: 29rpx; font-weight: 700; text-align: center; }
.modal-body { padding: 10rpx 24rpx 20rpx; }
.modal-field { display: flex; align-items: center; min-height: 72rpx; border-bottom: 1rpx solid #294142; }
.modal-field:last-child { border-bottom: none; }
.modal-label { flex-shrink: 0; width: 120rpx; color: #a1b2b0; font-size: 24rpx; }
.modal-input { flex: 1; min-height: 58rpx; box-sizing: border-box; padding: 8rpx 0; color: #f2f7f5; font-family: "SFMono-Regular", Consolas, monospace; font-size: 25rpx; line-height: 42rpx; text-align: right; }
.modal-actions { display: flex; border-top: 1rpx solid #294142; }
.modal-btn { flex: 1; padding: 22rpx 0; border-radius: 0; font-size: 27rpx; }
.modal-btn-cancel { border-right: 1rpx solid #294142; }
