<view class="page book-page"><view wx:if="{{loading}}" class="loading-tip">正在加载客户账本...</view><view wx:elif="{{book}}"><view class="customer-head"><text class="customer-name">{{book.customer.name}}</text><text class="customer-phone">{{book.customer.phone || '未设置联系电话'}}</text><text class="balance-label {{book.customer.balanceClass}}">{{book.customer.balanceLabel}}</text><text class="balance-value {{book.customer.balanceClass}}">{{book.customer.balanceDisplay}}</text></view><view class="summary-grid card"><view><text>出货账额</text><text class="sale">{{book.customer.salesDisplay}}</text></view><view><text>进货账额</text><text class="purchase">{{book.customer.purchaseDisplay}}</text></view><view><text>已回款</text><text class="received">{{book.customer.receivedDisplay}}</text></view></view><button class="btn-primary payment-btn" bindtap="openPayment">+ 记录客户回款</button><view class="card statement-card"><text class="section-title">生成结账信息</text><view class="statement-dates"><picker mode="date" value="{{statementStart}}" bindchange="onStatementStart"><view>{{statementStart}}</view></picker><text>至</text><picker mode="date" value="{{statementEnd}}" bindchange="onStatementEnd"><view>{{statementEnd}}</view></picker></view><button class="btn-secondary statement-btn" loading="{{creatingStatement}}" disabled="{{creatingStatement}}" bindtap="createStatement">生成只读结账单</button></view><view class="card"><text class="section-title">账单记录</text><view wx:if="{{!book.bills.length}}" class="inline-empty">该客户还没有账单</view><view wx:for="{{book.bills}}" wx:key="id" class="record-row" data-id="{{item.id}}" bindtap="goBill"><view><text class="record-tag {{item.directionClass}}">{{item.directionText}}</text><text class="record-date">{{item.billDate}}</text></view><text class="record-total {{item.directionClass}}">{{item.totalDisplay}}</text></view></view><view class="card"><text class="section-title">回款记录</text><view wx:if="{{!book.payments.length}}" class="inline-empty">还没有回款记录</view><view wx:for="{{book.payments}}" wx:key="id" class="record-row"><view><text class="record-tag received">回款</text><text class="record-date">{{item.paymentDate}}</text></view><text class="record-total received">{{item.amountDisplay}}</text></view></view></view><view wx:else class="empty-state"><text class="empty-text">客户不存在或已归档</text></view></view>
<view wx:if="{{showPayment}}" class="modal-mask" bindtap="closePayment"><view class="dialog" catchtap="noop"><text class="dialog-title">客户回款</text><input class="dialog-input" type="digit" placeholder="回款金额" value="{{paymentAmount}}" bindinput="onPaymentAmount" /><picker mode="date" value="{{paymentDate}}" bindchange="onPaymentDate"><view class="date-picker">{{paymentDate}}</view></picker><input class="dialog-input" placeholder="备注（选填）" value="{{paymentRemark}}" bindinput="onPaymentRemark" /><view class="dialog-actions"><button class="btn-secondary" bindtap="closePayment">取消</button><button class="btn-primary" loading="{{savingPayment}}" disabled="{{savingPayment}}" bindtap="savePayment">确认回款</button></view></view></view>
