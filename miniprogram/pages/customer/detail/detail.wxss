.book-page { padding: 24rpx; }
.customer-head { padding: 28rpx; border: 1rpx solid var(--border-strong); border-radius: 7rpx; background: var(--surface); }
.customer-name { display: block; color: var(--text); font-size: 40rpx; font-weight: 700; }
.customer-phone { display: block; margin-top: 8rpx; color: var(--text-muted); font-size: 23rpx; }
.phone-row { display: flex; align-items: center; margin-top: 8rpx; }
.phone-row .customer-phone { margin-top: 0; }
.phone-row .phone-empty { color: var(--primary); }
.phone-edit { margin-left: 12rpx; padding: 2rpx 12rpx; border: 1rpx solid var(--border-strong); border-radius: 20rpx; color: var(--primary); font-size: 19rpx; }
.balance-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; margin-top: 28rpx; }
.balance-grid view { min-width: 0; padding: 18rpx; border: 1rpx solid var(--border); background: var(--surface-2); }
.balance-label { display: block; color: var(--text-muted); font-size: 22rpx; }
.balance-value { display: block; margin-top: 8rpx; font-size: 36rpx; font-weight: 700; }
.receivable { color: var(--sale); }.payable { color: var(--warn); }.settled, .received { color: var(--purchase); }
.paid { color: var(--warn); }
.summary-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx 10rpx; text-align: center; }
.summary-grid view { min-width: 0; }.summary-grid text { display: block; color: var(--text-muted); font-size: 21rpx; }.summary-grid text + text { margin-top: 10rpx; font-size: 25rpx; font-weight: 700; }.sale { color: var(--sale) !important; }.purchase { color: var(--warn) !important; }
.payment-actions { display: flex; gap: 14rpx; margin-bottom: 20rpx; }
.payment-btn { min-width: 0; flex: 1; margin: 0; }
.settled-tip { margin-bottom: 20rpx; padding: 24rpx; border: 1rpx solid var(--border); color: var(--purchase); text-align: center; }
.statement-card { padding-bottom: 22rpx; }.statement-dates { display: flex; align-items: center; justify-content: space-between; color: var(--text-muted); font-size: 23rpx; }.statement-dates picker { min-width: 220rpx; padding: 14rpx 0; border-bottom: 1rpx solid var(--border); color: var(--text); text-align: center; }.statement-btn { margin-top: 20rpx; }
.section-title { display: block; margin-bottom: 14rpx; color: var(--text); font-weight: 600; }
.record-row { display: flex; align-items: center; justify-content: space-between; min-height: 82rpx; border-top: 1rpx solid var(--border); }
.record-tag { display: inline-block; padding: 3rpx 9rpx; border-radius: 4rpx; font-size: 20rpx; }.record-tag.sale { color: var(--sale); background: rgba(var(--sale-rgb), .1); }.record-tag.purchase, .record-tag.paid { color: var(--warn); background: rgba(var(--warn-rgb), .1); }.record-tag.received { color: var(--purchase); background: rgba(var(--purchase-rgb), .1); }
.record-date { margin-left: 12rpx; color: var(--text-muted); font-size: 22rpx; }.record-total { font-weight: 600; }.record-total.sale { color: var(--sale); }.record-total.purchase, .record-total.paid { color: var(--warn); }.record-total.received { color: var(--purchase); }
.inline-empty { padding: 30rpx 0; color: var(--text-muted); text-align: center; font-size: 23rpx; }
.delete-customer-btn { margin: 36rpx 0 24rpx; padding: 20rpx; border: 1rpx solid rgba(var(--sale-rgb), 0.55); background: transparent; color: var(--sale); font-size: 26rpx; }
.archive-label { display: block; margin-top: 8rpx; color: var(--text-muted); font-size: 23rpx; }
.dialog { width: 620rpx; padding: 30rpx; box-sizing: border-box; background: var(--surface); border: 1rpx solid var(--border-strong); border-radius: 8rpx; }.dialog-title { display: block; margin-bottom: 24rpx; color: var(--text); font-size: 32rpx; font-weight: 600; }.dialog-input, .date-picker { width: 100%; min-height: 72rpx; box-sizing: border-box; margin-bottom: 16rpx; padding: 0 18rpx; border: 1rpx solid var(--border-strong); border-radius: 4rpx; color: var(--text); line-height: 72rpx; }.dialog-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }.dialog-actions button { flex: 1; }
