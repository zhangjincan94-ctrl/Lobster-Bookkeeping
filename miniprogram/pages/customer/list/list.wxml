<view class="page customer-page"><view class="page-head"><view><text class="page-title">客户</text><text class="page-subtitle">统一管理所有往来客户</text></view><text class="add-link" bindtap="openAdd">+ 新增</text></view><view class="search-bar"><input placeholder="搜索客户名称或电话" value="{{keyword}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearch" /><text bindtap="onSearch">搜索</text></view><view wx:if="{{loading}}" class="loading-tip">正在加载客户...</view><view wx:elif="{{!customers.length}}" class="empty-state"><text class="empty-icon">○</text><text class="empty-text">还没有客户</text><button class="btn-primary empty-action" bindtap="openAdd">新增客户</button></view><view wx:else><view wx:for="{{customers}}" wx:key="id" class="customer-row" data-id="{{item.id}}" bindtap="goDetail"><view class="avatar">{{item.name.slice(0, 1)}}</view><view class="customer-info"><text class="customer-name">{{item.name}}</text><text class="customer-phone">{{item.phone || '未设置电话'}}</text></view><view class="balance-box"><text class="balance-label {{item.balanceClass}}">{{item.balanceLabel}}</text><text class="balance-value {{item.balanceClass}}">{{item.balanceDisplay}}</text></view><text class="chevron">›</text></view></view></view>
<view wx:if="{{showAdd}}" class="modal-mask" bindtap="closeAdd"><view class="dialog" catchtap="noop"><text class="dialog-title">新增客户</text><input class="dialog-input" placeholder="客户名称" value="{{newName}}" bindinput="onNameInput" /><input class="dialog-input" placeholder="联系电话（选填）" type="number" value="{{newPhone}}" bindinput="onPhoneInput" /><view class="dialog-actions"><button class="btn-secondary" bindtap="closeAdd">取消</button><button class="btn-primary" loading="{{creating}}" disabled="{{creating}}" bindtap="createCustomer">保存</button></view></view></view>
