<view class="page customer-page">
  <view class="page-head">
    <view><text class="page-title">往来对象</text><text class="page-subtitle">统一管理客户与供应商</text></view>
    <text class="add-link" bindtap="openAdd">+ 新增</text>
  </view>
  <view class="search-bar"><input placeholder="搜索名称或电话" value="{{keyword}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearch" /><text bindtap="onSearch">搜索</text></view>
  <view class="status-tabs"><view class="status-tab {{!archived ? 'active' : ''}}" data-archived="0" bindtap="switchStatus">往来对象</view><view class="status-tab {{archived ? 'active' : ''}}" data-archived="1" bindtap="switchStatus">已归档</view></view>
  <view wx:if="{{loading}}" class="loading-tip">正在加载往来对象...</view>
  <view wx:elif="{{!customers.length}}" class="empty-state"><text class="empty-icon">○</text><text class="empty-text">{{archived ? '还没有已归档的往来对象' : '还没有往来对象'}}</text><button wx:if="{{!archived}}" class="btn-primary empty-action" bindtap="openAdd">新增往来对象</button></view>
  <view wx:else>
    <view wx:for="{{customers}}" wx:key="id" class="customer-row" data-id="{{item.id}}" bindtap="goDetail" bindlongpress="onCustomerLongPress">
      <view class="avatar">{{item.name.slice(0, 1)}}</view>
      <view class="customer-info"><text class="customer-name">{{item.name}}</text><text class="customer-phone">{{item.phone || '未设置电话'}}</text></view>
      <view class="balance-box">
        <view wx:if="{{item.receivableBalance > 0}}" class="balance-line receivable"><text>待收</text><text>{{item.receivableDisplay}}</text></view>
        <view wx:if="{{item.payableBalance > 0}}" class="balance-line payable"><text>待付</text><text>{{item.payableDisplay}}</text></view>
        <text wx:if="{{item.receivableBalance <= 0 && item.payableBalance <= 0}}" class="settled">{{archived ? '已归档' : '已平'}}</text>
      </view>
      <text class="chevron">›</text>
    </view>
  </view>
</view>
<view wx:if="{{showAdd}}" class="modal-mask" bindtap="closeAdd">
  <view class="dialog" catchtap="noop">
    <text class="dialog-title">新增往来对象</text>
    <input class="dialog-input" placeholder="名称" value="{{newName}}" bindinput="onNameInput" />
    <input class="dialog-input" placeholder="联系电话（选填）" type="number" value="{{newPhone}}" bindinput="onPhoneInput" />
    <view class="dialog-actions"><button class="btn-secondary" bindtap="closeAdd">取消</button><button class="btn-primary" loading="{{creating}}" disabled="{{creating}}" bindtap="createCustomer">保存</button></view>
  </view>
</view>
