.detail-page { padding: 24rpx; }
.bill-panel { overflow: hidden; border: 1rpx solid var(--border-strong); border-radius: 8rpx; background: var(--surface); }
.bill-meta { display: flex; align-items: center; justify-content: space-between; min-height: 112rpx; padding: 0 24rpx; border-bottom: 1rpx solid var(--border); }
.bill-date { color: var(--primary); font-size: 29rpx; font-weight: 700; }
.bill-customer { display: flex; align-items: center; max-width: 52%; color: var(--text); font-size: 28rpx; font-weight: 600; }
.bill-customer > text:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.direction-tag { flex: none; margin-right: 10rpx; padding: 3rpx 9rpx; border-radius: 4rpx; font-size: 19rpx; }
.direction-tag.sale { color: var(--sale); background: rgba(var(--sale-rgb), .12); }
.direction-tag.purchase { color: var(--warn); background: rgba(var(--warn-rgb), .12); }
.detail-head, .detail-row { display: grid; grid-template-columns: minmax(0, 1.6fr) .8fr .9fr 1fr; align-items: center; text-align: center; }
.detail-head { min-height: 66rpx; border-bottom: 1rpx solid var(--border-strong); color: var(--text-muted); font-size: 22rpx; }
.detail-row { min-height: 82rpx; border-bottom: 1rpx solid var(--border); color: var(--text); font-size: 24rpx; }
.detail-head text, .detail-row text { min-width: 0; padding: 0 6rpx; }
.product-name { overflow: hidden; color: var(--text); text-overflow: ellipsis; white-space: nowrap; }
.row-total { color: var(--primary); font-weight: 600; }
.bill-total-row { display: flex; align-items: center; justify-content: space-between; min-height: 96rpx; padding: 0 24rpx; color: var(--text-muted); font-size: 23rpx; }
.bill-total { font-size: 36rpx; font-weight: 700; }
.bill-total.sale { color: var(--sale); }
.bill-total.purchase { color: var(--warn); }
.bill-remark { display: flex; gap: 24rpx; padding: 20rpx 24rpx; border-top: 1rpx solid var(--border); color: var(--text-muted); font-size: 23rpx; line-height: 1.55; }
.bill-remark text:last-child { flex: 1; color: var(--text); }
.action-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; margin-top: 38rpx; }
.action-item { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 150rpx; border: 1rpx solid transparent; border-radius: 6rpx; color: var(--text); line-height: 1; }
.action-item-active { border-color: var(--border-strong); background: rgba(var(--primary-rgb), .06); }
.action-icon { display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; margin-bottom: 15rpx; border: 1rpx solid var(--border-strong); border-radius: 6rpx; background: var(--surface); font-size: 42rpx; font-weight: 500; }
.action-label { font-size: 25rpx; }
.image-icon { color: var(--primary); }
.text-icon { color: var(--primary); font-size: 30rpx; }
.edit-icon { color: var(--purchase); font-size: 29rpx; font-weight: 700; }
.back-icon { color: var(--text-muted); }
.poster-canvas { position: fixed; top: 0; left: -1000px; width: 750px; pointer-events: none; opacity: 0; }
