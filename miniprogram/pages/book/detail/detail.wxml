<view class="page detail-page"><view wx:if="{{loading}}" class="loading-tip">正在加载账单...</view><view wx:elif="{{bill}}"><view class="hero-card"><view><text class="direction-tag {{bill.directionClass}}">{{bill.directionText}}</text><text class="customer">{{bill.customerName}}</text></view><text class="total {{bill.directionClass}}">{{bill.totalDisplay}}</text><text class="date">{{bill.billDate}}</text></view><view class="card"><view class="section-title">商品明细</view><view wx:for="{{bill.items}}" wx:key="id" class="line"><view><text class="product">{{item.productName}}</text><text class="unit">{{item.quantity}} {{item.unit}} × ¥{{item.unitPrice}}</text></view><text class="subtotal">{{item.subtotalDisplay}}</text></view></view><view wx:if="{{bill.remark}}" class="card"><text class="section-title">备注</text><text class="remark">{{bill.remark}}</text></view><button class="btn-danger delete-btn" bindtap="removeBill">删除账单</button></view><view wx:else class="empty-state"><text class="empty-text">账单不存在或已删除</text></view></view>
