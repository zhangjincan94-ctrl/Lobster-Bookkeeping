.text-page { min-height: 100vh; padding: 24rpx 24rpx calc(150rpx + env(safe-area-inset-bottom)); }
.title-band { display: flex; align-items: flex-end; justify-content: space-between; margin: 4rpx 0 24rpx; }
.page-title { color: var(--text); font-size: 40rpx; font-weight: 700; }
.page-subtitle { color: var(--text-faint); font-size: 22rpx; }
.text-editor { min-height: 760rpx; padding: 28rpx; border: 1rpx solid var(--border-strong); border-radius: 8rpx; background: var(--surface); }
.text-editor textarea { width: 100%; height: 720rpx; color: var(--text); font-family: "SFMono-Regular", Consolas, monospace; font-size: 28rpx; line-height: 1.75; }
.copy-bar { position: fixed; right: 0; bottom: 0; left: 0; padding: 18rpx 24rpx; padding-bottom: calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--border); background: var(--surface); }
.copy-btn { width: 100%; margin: 0; }
