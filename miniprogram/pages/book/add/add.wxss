.bill-page { padding: 24rpx 24rpx 144rpx; }
.title-band { margin: 4rpx 0 24rpx; }
.page-title { display: block; font-size: 40rpx; font-weight: 700; color: var(--text); }
.page-subtitle { display: block; margin-top: 8rpx; font-size: 24rpx; color: var(--text-muted); }
.form-card { padding: 0 24rpx; }
.field-row, .direction-row { display: flex; min-height: 96rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--border); }
.field-row:last-child { border-bottom: 0; }
.field-column { display: block; padding: 22rpx 0; }
.field-label { color: var(--text-muted); font-size: 26rpx; }
.field-action { display: flex; align-items: center; max-width: 70%; }
.picker-value { color: var(--text); }
.placeholder { color: var(--text-faint); }
.chevron { margin-left: 12rpx; color: var(--primary); font-size: 36rpx; }
.date-actions { gap: 18rpx; }
.quick-date, .clear-link, .library-link { color: var(--primary); font-size: 24rpx; }
.segmented-control { display: flex; border: 1rpx solid var(--border-strong); border-radius: 6rpx; overflow: hidden; }
.segment { width: 102rpx; padding: 12rpx 0; text-align: center; color: var(--text-muted); font-size: 24rpx; }
.segment-sale-active { background: rgba(var(--sale-rgb), .16); color: var(--sale); }
.segment-purchase-active { background: rgba(var(--warn-rgb), .16); color: var(--warn); }
.bill-table { margin: 20rpx 0; border-top: 1rpx solid var(--border-strong); border-left: 1rpx solid var(--border-strong); background: var(--surface); }
.item-head, .bill-item { display: grid; grid-template-columns: minmax(0, 1.75fr) 1.05fr 1.05fr 1.25fr .7fr; align-items: stretch; }
.item-head { color: var(--text-muted); font-size: 20rpx; }
.item-head text { display: flex; min-height: 60rpx; align-items: center; justify-content: center; padding: 0 6rpx; box-sizing: border-box; border-right: 1rpx solid var(--border-strong); border-bottom: 1rpx solid var(--border-strong); text-align: center; }
.bill-item { min-height: 92rpx; }
.product-cell, .compact-input, .subtotal-cell, .remove-item { box-sizing: border-box; border-right: 1rpx solid var(--border); border-bottom: 1rpx solid var(--border); }
.product-cell { display: flex; min-width: 0; flex-direction: column; justify-content: center; padding: 0 10rpx; }
.row-meta { display: block; margin-top: 5rpx; color: var(--text-faint); font-size: 20rpx; }
.product-input { width: 100%; min-height: 42rpx; padding: 0; border: 0; color: var(--text); font-size: 23rpx; }
.compact-input { width: 100%; min-height: 90rpx; padding: 0 6rpx; border: 0; border-right: 1rpx solid var(--border); border-bottom: 1rpx solid var(--border); color: var(--text); font-size: 23rpx; text-align: center; }
.subtotal-cell { display: flex; align-items: center; justify-content: center; color: var(--sale); font-size: 22rpx; }
.remove-item { display: flex; align-items: center; justify-content: center; color: var(--sale); font-size: 38rpx; }
.inline-empty { padding: 40rpx 0; color: var(--text-muted); text-align: center; font-size: 25rpx; }
.item-actions { display: flex; gap: 12rpx; padding: 16rpx; border-right: 1rpx solid var(--border-strong); border-bottom: 1rpx solid var(--border-strong); }
.table-action { flex: 1; margin: 0; padding: 12rpx 0; font-size: 23rpx; }
.remark-input { width: 100%; min-height: 110rpx; margin-top: 16rpx; color: var(--text); font-size: 26rpx; }
.bottom-space { height: calc(100rpx + env(safe-area-inset-bottom)); }
.submit-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 2; display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx; padding-bottom: calc(18rpx + env(safe-area-inset-bottom)); background: var(--surface); border-top: 1rpx solid var(--border); }
.total-label { display: block; color: var(--text-muted); font-size: 21rpx; }
.total-value { display: block; margin-top: 4rpx; color: var(--sale); font-size: 34rpx; font-weight: 700; }
.submit-btn { width: 244rpx; margin: 0; padding: 20rpx 0; }
.sheet { position: absolute; right: 0; bottom: 0; left: 0; max-height: 74vh; padding: 24rpx; box-sizing: border-box; background: var(--surface); border: 1rpx solid var(--border-strong); border-radius: 8rpx 8rpx 0 0; }
.sheet-head { display: flex; justify-content: space-between; margin-bottom: 20rpx; color: var(--text); font-size: 32rpx; font-weight: 600; }
.sheet-close { color: var(--text-muted); font-size: 38rpx; }
.search-input, .dialog-input { min-height: 72rpx; box-sizing: border-box; padding: 0 18rpx; border: 1rpx solid var(--border-strong); border-radius: 4rpx; color: var(--text); }
.sheet-list { max-height: 610rpx; margin-top: 16rpx; }
.select-row { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; border-bottom: 1rpx solid var(--border); color: var(--text); }
.balance { color: var(--primary); font-size: 24rpx; }
.sheet-action { margin-top: 20rpx; }
.dialog { width: 620rpx; padding: 30rpx; box-sizing: border-box; background: var(--surface); border: 1rpx solid var(--border-strong); border-radius: 8rpx; }
.dialog-title { display: block; margin-bottom: 24rpx; color: var(--text); font-size: 32rpx; font-weight: 600; }
.dialog-input { display: block; width: 100%; margin-bottom: 16rpx; }
.dialog-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.dialog-actions button { flex: 1; }
