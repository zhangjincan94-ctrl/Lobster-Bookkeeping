<view class="page bill-page">
  <view wx:if="{{loadingBill}}" class="loading-tip">正在加载账单...</view>
  <block wx:else>
    <view class="title-band">
      <text class="page-title">{{editing ? '修改账单' : '新建账单'}}</text>
      <text class="page-subtitle">{{editing ? '修改后将更新原账单' : '往来对象与商品均由你自己维护'}}</text>
    </view>

    <view class="card form-card">
      <view class="field-row">
        <text class="field-label">交易日期</text>
        <view class="field-action date-actions">
          <text class="quick-date" bindtap="chooseToday">今天</text>
          <text class="quick-date" bindtap="chooseYesterday">昨天</text>
          <picker mode="date" value="{{billDate}}" bindchange="onDateChange"><text class="picker-value">{{billDate}}</text></picker>
        </view>
      </view>
      <view class="field-row" bindtap="openCustomerModal">
        <text class="field-label">{{direction === 'purchase' ? '供应商' : '交易客户'}}</text>
        <view class="field-action"><text class="{{customerName ? 'picker-value' : 'placeholder'}}">{{customerName || (direction === 'purchase' ? '选择供应商' : '选择客户')}}</text><text class="chevron">›</text></view>
      </view>
      <view class="direction-row">
        <text class="field-label">账单方向</text>
        <view class="segmented-control">
          <view class="segment {{direction === 'sale' ? 'segment-sale-active' : ''}}" data-direction="sale" bindtap="setDirection">出货</view>
          <view class="segment {{direction === 'purchase' ? 'segment-purchase-active' : ''}}" data-direction="purchase" bindtap="setDirection">进货</view>
        </view>
      </view>
    </view>

    <view class="bill-table">
      <view class="item-head"><text>商品（{{items.length}}）</text><text>数量</text><text>单价</text><text>结算</text><text>移除</text></view>
      <view wx:for="{{items}}" wx:key="rowId" class="bill-item">
        <view class="product-cell"><input class="product-input" placeholder="商品" value="{{item.productName}}" data-index="{{index}}" bindfocus="onProductNameFocus" bindinput="onProductNameInput" /></view>
        <input class="compact-input" type="digit" value="{{item.quantity}}" data-index="{{index}}" data-field="quantity" bindinput="onItemInput" />
        <input class="compact-input" type="digit" value="{{item.unitPrice}}" data-index="{{index}}" data-field="unitPrice" bindinput="onItemInput" />
        <text class="subtotal-cell">¥{{item.subtotal}}</text>
        <text class="remove-item" data-index="{{index}}" bindtap="removeItem">×</text>
      </view>
      <view wx:if="{{!items.length}}" class="inline-empty">点击“添加”开始录入商品</view>
      <view class="item-actions"><button class="btn-secondary table-action" bindtap="addEmptyItem">+ 添加</button><button class="btn-secondary table-action" bindtap="goProductLibrary">商品库</button><button class="btn-secondary table-action" bindtap="clearItems">清除</button></view>
    </view>

    <view class="card form-card">
      <view class="field-row field-column"><text class="field-label">备注</text><textarea class="remark-input" placeholder="选填，记录本次交易说明" maxlength="200" value="{{remark}}" bindinput="onRemarkInput" /></view>
    </view>

    <view class="bottom-space"></view>
    <view class="submit-bar"><view><text class="total-label">账单总额</text><text class="total-value">¥{{totalAmount}}</text></view><button class="submit-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{editing ? '确定修改' : '确认保存'}}</button></view>
  </block>
</view>
