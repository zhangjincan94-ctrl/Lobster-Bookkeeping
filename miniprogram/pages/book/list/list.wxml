<view class="page ledger-page">
  <view class="page-head"><view><text class="page-title">总账本</text><text class="page-subtitle">按日期查看全部进出货账单</text></view><text class="create-link" bindtap="goAdd">+ 开单</text></view>
  <view class="filter-bar"><view class="filter {{direction === '' ? 'filter-active' : ''}}" data-direction="" bindtap="chooseDirection">全部</view><view class="filter {{direction === 'sale' ? 'filter-sale-active' : ''}}" data-direction="sale" bindtap="chooseDirection">出货</view><view class="filter {{direction === 'purchase' ? 'filter-purchase-active' : ''}}" data-direction="purchase" bindtap="chooseDirection">进货</view></view>
  <view wx:if="{{loading}}" class="loading-tip">正在加载账本...</view>
  <view wx:elif="{{!bills.length}}" class="empty-state"><text class="empty-icon">□</text><text class="empty-text">还没有账单，先开一笔吧</text><button class="btn-primary empty-action" bindtap="goAdd">新建账单</button></view>
  <view wx:else class="bill-list"><view wx:for="{{bills}}" wx:key="id" class="bill-card" data-id="{{item.id}}" bindtap="goDetail"><view class="bill-top"><view><text class="direction-tag {{item.directionClass}}">{{item.directionText}}</text><text class="customer-name">{{item.customerName}}</text></view><text class="bill-total {{item.directionClass}}">{{item.totalDisplay}}</text></view><view class="bill-meta"><text>{{item.billDate}}</text><text>{{item.itemCount}} 项商品</text><text class="detail-link">查看明细 ›</text></view><view wx:if="{{item.items.length}}" class="item-preview"><text wx:for="{{item.items}}" wx:key="id" wx:for-item="line">{{line.productName}}{{index + 1 < item.items.length ? '、' : ''}}</text></view></view></view>
</view>
