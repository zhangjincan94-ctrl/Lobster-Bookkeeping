.ledger-page { padding: 24rpx 0 52rpx; }
.page-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 4rpx 0 24rpx; padding: 0 24rpx; }
.page-title { display: block; color: var(--text); font-size: 40rpx; font-weight: 700; }
.page-subtitle { display: block; margin-top: 8rpx; color: var(--text-muted); font-size: 23rpx; }
.create-link { color: var(--primary); font-size: 27rpx; }
.filter-bar { display: flex; gap: 12rpx; margin-bottom: 20rpx; padding: 0 24rpx; }
.filter { flex: 1; padding: 16rpx 0; border: 1rpx solid var(--border); border-radius: 5rpx; color: var(--text-muted); font-size: 24rpx; text-align: center; }
.filter-active { border-color: var(--primary); color: var(--primary); }
.filter-sale-active { border-color: var(--sale); color: var(--sale); background: rgba(var(--sale-rgb), .1); }
.filter-purchase-active { border-color: var(--warn); color: var(--warn); background: rgba(var(--warn-rgb), .1); }
.loading-tip { margin: 0 24rpx; }
.load-summary { padding: 18rpx 24rpx; border-bottom: 1rpx solid var(--border); color: var(--text-muted); font-size: 22rpx; }
.month-list { border-top: 1rpx solid var(--border-strong); }
.month-band, .day-band { display: flex; min-height: 92rpx; align-items: center; justify-content: space-between; box-sizing: border-box; padding: 16rpx 24rpx; }
.month-band { border-bottom: 1rpx solid var(--border); background: var(--warn-weak); }
.day-band { border-bottom: 1rpx solid var(--border); background: var(--surface-2); }
.band-summary { display: flex; min-width: 0; flex: 1; flex-wrap: wrap; align-items: baseline; gap: 8rpx 12rpx; }
.band-label { color: var(--text); font-size: 30rpx; font-weight: 650; }
.band-formula { color: var(--text-muted); font-size: 24rpx; }
.net-value { font-weight: 700; }
.net-value.positive { color: var(--sale); }
.net-value.negative { color: var(--warn); }
.expand-symbol { width: 48rpx; flex: 0 0 48rpx; color: var(--text-muted); font-size: 34rpx; text-align: right; }
.bill-list { padding: 18rpx 20rpx 4rpx; background: var(--bg); }
.bill-card { overflow: hidden; margin-bottom: 18rpx; border: 1rpx solid var(--border-strong); border-radius: 6rpx; background: var(--surface); }
.bill-summary { display: flex; min-height: 82rpx; align-items: center; justify-content: space-between; gap: 16rpx; padding: 0 20rpx; }
.bill-identity { display: flex; min-width: 0; flex: 1; align-items: center; }
.direction-dot { width: 18rpx; height: 18rpx; flex: 0 0 18rpx; border-radius: 50%; }
.direction-dot.sale { background: var(--sale); }
.direction-dot.purchase { background: var(--warn); }
.direction-text { margin-left: 10rpx; font-size: 25rpx; font-weight: 650; }
.direction-text.sale { color: var(--sale); }
.direction-text.purchase { color: var(--warn); }
.customer-name { overflow: hidden; margin-left: 12rpx; color: var(--text); font-size: 25rpx; text-overflow: ellipsis; white-space: nowrap; }
.bill-total { flex: 0 0 auto; font-size: 32rpx; font-weight: 700; }
.bill-total.sale { color: var(--sale); }
.bill-total.purchase { color: var(--warn); }
.bill-actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1rpx solid var(--border); border-bottom: 1rpx solid var(--border); }
.bill-actions button { width: 100%; height: 66rpx; margin: 0; padding: 0; border-radius: 0; font-size: 24rpx; line-height: 66rpx; }
.bill-actions button::after { border: 0; border-radius: 0; }
.toggle-detail-button { border-right: 1rpx solid var(--border); background: var(--surface-2); color: var(--text-muted); }
.view-button { border-right: 1rpx solid var(--primary); background: var(--primary); color: var(--on-primary); }
.delete-button { background: var(--sale); color: var(--on-primary); }
.delete-button[disabled] { background: var(--sale-weak); color: var(--text-faint); }
.bill-detail { background: var(--surface-2); }
.detail-row { display: grid; grid-template-columns: minmax(0, 1.55fr) .8fr .9fr 1fr; min-height: 68rpx; align-items: center; border-bottom: 1rpx solid var(--border); }
.detail-row:last-child { border-bottom: 0; }
.detail-row text { min-width: 0; padding: 10rpx 8rpx; color: var(--text-muted); font-size: 22rpx; text-align: center; word-break: break-all; }
.detail-head text { color: var(--text); font-size: 23rpx; font-weight: 600; }
.detail-row .product-name { color: var(--text); text-align: left; }
.detail-empty { padding: 30rpx 20rpx; color: var(--text-faint); font-size: 22rpx; text-align: center; }
.empty-action { width: 260rpx; margin-top: 30rpx; }
