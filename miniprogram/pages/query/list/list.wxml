<view class="page query-page"><view class="page-head"><view><text class="page-title">查询统计</text><text class="page-subtitle">按方向和日期筛选账单</text></view><text class="clear-link" bindtap="clear">清空</text></view><view class="card filter-card"><view class="direction-filter"><view class="filter {{direction === '' ? 'active' : ''}}" data-direction="" bindtap="chooseDirection">全部</view><view class="filter sale {{direction === 'sale' ? 'active' : ''}}" data-direction="sale" bindtap="chooseDirection">出货</view><view class="filter purchase {{direction === 'purchase' ? 'active' : ''}}" data-direction="purchase" bindtap="chooseDirection">进货</view></view><view class="date-row"><picker mode="date" value="{{startDate}}" bindchange="onStartDate"><view>{{startDate || '开始日期'}}</view></picker><text>至</text><picker mode="date" value="{{endDate}}" bindchange="onEndDate"><view>{{endDate || '结束日期'}}</view></picker></view></view><view class="summary"><view><text>账单数量</text><text>{{totalCount}} 笔</text></view><view><text>账单金额</text><text>{{totalAmount}}</text></view></view><view wx:if="{{loading}}" class="loading-tip">正在查询...</view><view wx:elif="{{!bills.length}}" class="empty-state"><text class="empty-icon">⌕</text><text class="empty-text">没有符合条件的账单</text></view><view wx:else><view wx:for="{{bills}}" wx:key="id" class="query-row" data-id="{{item.id}}" bindtap="goDetail"><view><text class="tag {{item.directionClass}}">{{item.directionText}}</text><text class="customer">{{item.customerName}}</text><text class="date">{{item.billDate}} · {{item.itemCount}} 项商品</text></view><text class="total {{item.directionClass}}">{{item.totalDisplay}}</text></view></view></view>
