<view class="page query-page">
  <view class="page-head"><view><text class="page-title">查询统计</text><text class="page-subtitle">筛选账单，核对往来金额</text></view><button class="clear-link" bindtap="clear">重置</button></view>
  <view class="card filter-card">
    <view class="direction-filter"><button class="filter {{direction === '' ? 'active' : ''}}" data-direction="" bindtap="chooseDirection">全部</button><button class="filter sale {{direction === 'sale' ? 'active' : ''}}" data-direction="sale" bindtap="chooseDirection">出货</button><button class="filter purchase {{direction === 'purchase' ? 'active' : ''}}" data-direction="purchase" bindtap="chooseDirection">进货</button></view>
    <view class="period-row"><text class="filter-label">快捷时间</text><button class="period {{period === 'week' ? 'active' : ''}}" data-period="week" bindtap="choosePeriod">近 7 天</button><button class="period {{period === 'month' ? 'active' : ''}}" data-period="month" bindtap="choosePeriod">本月</button></view>
    <view class="date-row"><picker mode="date" value="{{startDate}}" end="{{endDate}}" bindchange="onStartDate"><view class="date-field">{{startDate || '开始日期'}}</view></picker><text class="date-separator">至</text><picker mode="date" value="{{endDate}}" start="{{startDate}}" bindchange="onEndDate"><view class="date-field">{{endDate || '结束日期'}}</view></picker></view>
  </view>
  <view wx:if="{{!loading && !error}}" class="summary"><view class="summary-head"><text>筛选结果</text><text>共 {{totalCount}} 笔</text></view><view class="summary-grid"><view><text class="metric-label">出货账额</text><text class="metric sale-text">{{saleAmount}}</text></view><view><text class="metric-label">进货账额</text><text class="metric purchase-text">{{purchaseAmount}}</text></view></view><text class="summary-note">账单金额不等于实际收付款或利润</text></view>
  <view wx:if="{{loading}}" class="empty-state"><text class="empty-text">正在汇总全部账单…</text><text class="empty-sub">账单较多时可能需要一点时间</text></view>
  <view wx:elif="{{error}}" class="empty-state"><text class="empty-icon">!</text><text class="empty-text">{{error}}</text><button class="btn-secondary retry-btn" bindtap="loadBills">重新查询</button></view>
  <view wx:elif="{{!bills.length}}" class="empty-state"><text class="empty-icon">⌕</text><text class="empty-text">没有符合条件的账单</text><text class="empty-sub">试试调整方向或日期范围</text></view>
  <view wx:else><view wx:for="{{bills}}" wx:key="id" class="query-row" data-id="{{item.id}}" bindtap="goDetail"><view class="row-heading"><text class="tag {{item.directionClass}}">{{item.directionText}}</text><text class="customer">{{item.customerName}}</text><text class="chevron">›</text></view><view class="row-footer"><text class="date">{{item.billDate}} · {{item.itemCount || 0}} 项商品</text><text class="total {{item.directionClass}}">{{item.totalDisplay}}</text></view></view><button wx:if="{{hasMore}}" class="load-more" bindtap="loadMore">继续查看（{{bills.length}} / {{totalCount}}）</button><view wx:else class="loading-tip">已显示全部 {{totalCount}} 笔账单</view></view>
</view>
