.query-page { padding: 24rpx; }.page-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 4rpx 0 24rpx; }.page-title { display: block; color: #f2f7f5; font-size: 40rpx; font-weight: 700; }.page-subtitle { display: block; margin-top: 8rpx; color: #a1b2b0; font-size: 23rpx; }.clear-link { color: #5de6dc; font-size: 25rpx; }.filter-card { padding: 20rpx; }.direction-filter { display: flex; gap: 12rpx; }.filter { flex: 1; padding: 14rpx 0; border: 1rpx solid #294142; border-radius: 4rpx; color: #a1b2b0; font-size: 23rpx; text-align: center; }.filter.active { border-color: #5de6dc; color: #5de6dc; }.filter.sale.active { border-color: #ff967f; color: #ff967f; }.filter.purchase.active { border-color: #f2ca72; color: #f2ca72; }.date-row { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; color: #a1b2b0; font-size: 24rpx; }.date-row picker { min-width: 220rpx; padding: 12rpx 0; color: #f2f7f5; text-align: center; }.summary { display: grid; grid-template-columns: repeat(2, 1fr); margin-bottom: 20rpx; border: 1rpx solid #294142; border-radius: 6rpx; background: #122526; }.summary view { padding: 22rpx; }.summary view + view { border-left: 1rpx solid #294142; }.summary text { display: block; color: #a1b2b0; font-size: 22rpx; }.summary text + text { margin-top: 8rpx; color: #5de6dc; font-size: 30rpx; font-weight: 700; }.query-row { display: flex; align-items: center; justify-content: space-between; min-height: 96rpx; margin-bottom: 14rpx; padding: 0 20rpx; border: 1rpx solid #294142; border-radius: 6rpx; background: #122526; }.tag { display: inline-block; padding: 3rpx 9rpx; border-radius: 4rpx; font-size: 20rpx; }.tag.sale { color: #ff967f; background: rgba(255, 98, 70, .1); }.tag.purchase { color: #f2ca72; background: rgba(231, 180, 71, .1); }.customer { margin-left: 10rpx; color: #f2f7f5; font-weight: 600; }.date { display: block; margin-top: 8rpx; color: #a1b2b0; font-size: 21rpx; }.total { font-weight: 700; }.total.sale { color: #ff967f; }.total.purchase { color: #f2ca72; }
