.page { min-height: 100vh; padding: 16rpx 24rpx 32rpx; }
.summary-card { position: relative; overflow: hidden; padding: 24rpx 22rpx; border: 1rpx solid rgba(255, 104, 104, 0.45); border-radius: 6rpx; background-color: rgba(255, 104, 104, 0.08); }
.summary-label { display: block; color: #a1b2b0; font-family: "SFMono-Regular", Consolas, monospace; font-size: 20rpx; letter-spacing: 2rpx; }
.summary-value { display: block; margin-top: 10rpx; color: #ff8c8c; font-family: "SFMono-Regular", Consolas, monospace; font-size: 48rpx; font-weight: 700; }
.summary-sub { display: block; margin-top: 10rpx; color: #a1b2b0; font-size: 21rpx; }
.debt-list { display: flex; flex-direction: column; margin-top: 16rpx; }
.debt-item { margin-bottom: 12rpx; padding: 20rpx; border: 1rpx solid #294142; border-left: 3rpx solid #ff6868; border-radius: 6rpx; background-color: #122526; }
.debt-head { display: flex; align-items: center; }
.debt-rank { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; margin-right: 14rpx; border: 1rpx solid #3c6867; color: #5de6dc; font-family: "SFMono-Regular", Consolas, monospace; font-size: 20rpx; }
.debt-info { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.debt-name { overflow: hidden; color: #f2f7f5; font-size: 27rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.debt-sub { margin-top: 5rpx; color: #a1b2b0; font-size: 19rpx; }
.debt-amount-wrap { display: flex; flex-direction: column; align-items: flex-end; margin-left: 12rpx; }
.debt-amount { color: #ff8c8c; font-family: "SFMono-Regular", Consolas, monospace; font-size: 28rpx; font-weight: 700; }
.debt-amount-sub { margin-top: 5rpx; color: #a1b2b0; font-size: 18rpx; }
.debt-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding-top: 12rpx; border-top: 1rpx dashed #294142; }
.debt-foot-text { color: #a1b2b0; font-size: 19rpx; }
.debt-actions { display: flex; align-items: center; }
.debt-action { margin-left: 12rpx; padding: 7rpx 10rpx; border: 1rpx solid #3c6867; border-radius: 3rpx; background: transparent; color: #5de6dc; font-size: 20rpx; line-height: 1.2; }
.debt-action-share { border-color: rgba(255, 104, 104, 0.5); color: #ff8c8c; }
