.page {
  min-height: 100vh;
  padding: 16rpx 24rpx 32rpx;
}

.filter-card,
.overview-card,
.chart-card,
.link-card {
  margin-bottom: 16rpx;
  border: 1rpx solid #294142;
  border-radius: 6rpx;
  background-color: #122526;
}

.filter-card {
  padding: 16rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-item {
  min-width: 224rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid #294142;
  border-radius: 4rpx;
  background-color: #0b1e1f;
}

.picker-label {
  display: block;
  color: #718381;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.picker-value {
  display: block;
  margin-top: 4rpx;
  color: #f2f7f5;
  font-size: 23rpx;
}

.picker-sep {
  color: #718381;
  font-size: 22rpx;
}

.overview-card {
  overflow: hidden;
  padding: 0;
}

.overview-row {
  display: flex;
  border-bottom: 1rpx solid #294142;
}

.overview-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding: 22rpx 20rpx;
  border-right: 1rpx solid #294142;
}

.overview-item:nth-child(2) {
  border-right: none;
}

.overview-value {
  overflow: hidden;
  color: #f2f7f5;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 32rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-label {
  margin-top: 7rpx;
  color: #a1b2b0;
  font-size: 21rpx;
}

.overview-profit {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  border-top: 2rpx solid #5de6dc;
  background-color: rgba(93, 230, 220, 0.06);
}

.overview-profit-label {
  color: #a1b2b0;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.overview-profit-value {
  color: #5de6dc;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 38rpx;
  font-weight: 700;
}

.chart-card {
  padding: 20rpx;
}

.chart-header,
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.chart-title,
.link-title {
  color: #f2f7f5;
  font-size: 28rpx;
  font-weight: 700;
}

.dimension-tabs {
  display: flex;
}

.dimension-tab {
  margin-left: 14rpx;
  padding: 6rpx 0;
  border-bottom: 2rpx solid transparent;
  color: #718381;
  font-size: 22rpx;
}

.dimension-tab-active {
  border-color: #5de6dc;
  color: #5de6dc;
}

.trend-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #294142;
}

.trend-item:last-child {
  border-bottom: none;
}

.trend-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trend-period {
  color: #f2f7f5;
  font-size: 24rpx;
}

.trend-amount {
  color: #5de6dc;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 26rpx;
  font-weight: 700;
}

.trend-bar-bg {
  height: 10rpx;
  margin: 12rpx 0 8rpx;
  overflow: hidden;
  border: 1rpx solid #294142;
  border-radius: 0;
  background-color: #0b1e1f;
}

.trend-bar-fill {
  height: 100%;
  background-color: #00a9a5;
  box-shadow: 0 0 8rpx rgba(93, 230, 220, 0.5);
}

.trend-row-sub {
  color: #718381;
  font-size: 19rpx;
}

.link-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  padding: 0 20rpx;
}

.link-arrow {
  color: #5de6dc;
  font-size: 34rpx;
}
