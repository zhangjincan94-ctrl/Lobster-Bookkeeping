.trade-page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 24rpx 80rpx; background: var(--bg); color: var(--text); }
.trade-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; margin-bottom: 28rpx; }
.page-title { display: block; font-size: 38rpx; font-weight: 700; }
.range-text { display: block; margin-top: 10rpx; color: var(--text-muted); font-size: 21rpx; }
.period-switch { display: flex; flex-shrink: 0; padding: 4rpx; border: 1rpx solid var(--border-strong); border-radius: 5rpx; }
.period-option { min-width: 76rpx; padding: 10rpx 8rpx; color: var(--text-muted); font-size: 22rpx; text-align: center; }
.period-option.selected { background: var(--primary-weak); color: var(--primary); }
.state-text { padding: 80rpx 0; color: var(--text-muted); text-align: center; font-size: 26rpx; }
.retry-button { width: 180rpx; margin-top: 24rpx; font-size: 24rpx; }

.legend-dot { display: inline-block; flex: 0 0 12rpx; width: 12rpx; height: 12rpx; border-radius: 50%; }
.sale-dot { background: var(--sale); }
.purchase-dot { background: var(--purchase); }
.count-dot { background: var(--text-faint); }

.stat-tiles { display: flex; gap: 14rpx; }
.stat-tile { flex: 1; min-width: 0; padding: 18rpx 16rpx; border: 1rpx solid var(--border); border-radius: 8rpx; background: var(--surface); }
.tile-key { display: block; color: var(--text-muted); font-size: 20rpx; }
.tile-value { display: block; margin-top: 10rpx; overflow: hidden; font-size: 27rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }

.ring-card { display: flex; align-items: center; gap: 24rpx; margin-top: 20rpx; padding: 24rpx 20rpx; border: 1rpx solid var(--border); border-radius: 8rpx; background: var(--surface); }
.ring-wrap-sm { position: relative; flex: 0 0 184rpx; width: 184rpx; height: 184rpx; }
.ring-canvas-sm { display: block; width: 184rpx; height: 184rpx; }
.ring-center-sm { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: none; }
.ring-label { color: var(--text-muted); font-size: 18rpx; }
.ring-percent-sm { margin-top: 6rpx; color: var(--text); font-size: 34rpx; font-weight: 700; }
.c-legend { flex: 1; min-width: 0; }
.c-legend-item { padding: 10rpx 0; border-bottom: 1rpx solid var(--border); }
.c-legend-item:last-child { border-bottom: 0; }
.c-legend-main { display: flex; align-items: center; gap: 10rpx; font-size: 22rpx; }
.c-name { color: var(--text); }
.c-pct { margin-left: auto; color: var(--text-muted); font-size: 20rpx; }
.c-amt { width: 152rpx; color: var(--text); font-size: 23rpx; font-weight: 600; text-align: right; }
.c-change { display: block; margin-top: 4rpx; padding-left: 22rpx; color: var(--text-faint); font-size: 18rpx; }

.insight-band { margin-top: 20rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--border); color: var(--text); font-size: 24rpx; line-height: 1.6; }
.chart-section { margin-top: 36rpx; }
.section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.section-head text:first-child { font-size: 30rpx; font-weight: 700; }
.section-head text:last-child { color: var(--text-muted); font-size: 21rpx; }
.bar-chart { display: flex; align-items: flex-end; gap: 8rpx; height: 320rpx; padding-top: 40rpx; border-bottom: 1rpx solid var(--border-strong); }
.empty-chart { padding: 100rpx 0; color: var(--text-faint); font-size: 24rpx; text-align: center; }
.bar-group { display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.bar-track { display: flex; width: 100%; height: 245rpx; align-items: flex-end; justify-content: center; gap: 4rpx; }
.bar { width: 32%; max-width: 42rpx; min-height: 0; border-radius: 3rpx 3rpx 0 0; }
.bar-group.selected .bar { opacity: 1; }
.bar-group:not(.selected) .bar { opacity: .72; }
.sale-bar { background: var(--sale); }
.purchase-bar { background: var(--purchase); }
.bar-label { display: block; margin-top: 10rpx; color: var(--text-muted); font-size: 19rpx; text-align: center; white-space: nowrap; }
.bar-count { display: block; margin-top: 4rpx; color: var(--text-faint); font-size: 19rpx; }
.chart-key { display: flex; justify-content: center; gap: 30rpx; margin-top: 26rpx; color: var(--text-muted); font-size: 22rpx; }
.chart-key text { display: flex; align-items: center; gap: 8rpx; }
.bar-detail { display: flex; justify-content: space-between; gap: 10rpx; margin-top: 28rpx; padding: 20rpx 0; border-top: 1rpx solid var(--border); border-bottom: 1rpx solid var(--border); color: var(--text); font-size: 22rpx; }
.bar-detail view { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.method-note { margin-top: 38rpx; padding-top: 20rpx; border-top: 1rpx solid var(--border); color: var(--text-faint); font-size: 21rpx; line-height: 1.6; }
