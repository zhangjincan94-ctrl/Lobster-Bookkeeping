.page { min-height: 100vh; padding: 16rpx 24rpx 136rpx; }
.search-bar { margin-bottom: 16rpx; }
.search-input-wrap { display: flex; align-items: center; height: 76rpx; padding: 0 18rpx; border: 1rpx solid #294142; border-radius: 6rpx; background-color: #122526; }
.search-icon { margin-right: 12rpx; color: #5de6dc; font-size: 26rpx; }
.search-input { flex: 1; min-width: 0; color: #f2f7f5; font-family: "SFMono-Regular", Consolas, monospace; font-size: 25rpx; }
.buyer-list { display: flex; flex-direction: column; }
.swipe-row { position: relative; overflow: hidden; margin-bottom: 12rpx; border-radius: 6rpx; }
.buyer-item { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; margin: 0; padding: 18rpx 20rpx; border: 1rpx solid #294142; border-left: 3rpx solid #5de6dc; border-radius: 6rpx; background-color: #122526; }
.buyer-left { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.buyer-name { overflow: hidden; color: #f2f7f5; font-size: 28rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.buyer-phone { margin-top: 6rpx; color: #a1b2b0; font-family: "SFMono-Regular", Consolas, monospace; font-size: 21rpx; }
.buyer-arrow { color: #5de6dc; font-size: 32rpx; }
.swipe-action { position: absolute; top: 0; right: 0; bottom: 0; z-index: 0; display: flex; align-items: center; justify-content: center; width: 140rpx; background-color: #963e42; color: #fff4f2; font-size: 25rpx; }
.fab { position: fixed; z-index: 100; right: 32rpx; bottom: 114rpx; display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; border-radius: 8rpx; }
.fab-icon { font-family: "SFMono-Regular", Consolas, monospace; font-size: 48rpx; line-height: 1; }
.modal-mask { position: fixed; z-index: 200; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; }
.modal-content { width: 630rpx; overflow: hidden; border-radius: 8rpx; }
.modal-title { padding: 26rpx 24rpx 14rpx; color: #f2f7f5; font-family: "SFMono-Regular", Consolas, monospace; font-size: 29rpx; font-weight: 700; text-align: center; }
.modal-body { padding: 10rpx 24rpx 20rpx; }
.modal-field { display: flex; align-items: center; min-height: 72rpx; border-bottom: 1rpx solid #294142; }
.modal-field:last-child { border-bottom: none; }
.modal-label { flex-shrink: 0; width: 120rpx; color: #a1b2b0; font-size: 24rpx; }
.modal-input { flex: 1; min-height: 58rpx; box-sizing: border-box; padding: 8rpx 0; color: #f2f7f5; font-family: "SFMono-Regular", Consolas, monospace; font-size: 25rpx; line-height: 42rpx; text-align: right; }
.modal-actions { display: flex; border-top: 1rpx solid #294142; }
.modal-btn { flex: 1; padding: 22rpx 0; border-radius: 0; font-size: 27rpx; }
.modal-btn-cancel { border-right: 1rpx solid #294142; }
