<view class="page manage-page"><view class="title-band"><text class="page-title">添加商品</text><text class="page-subtitle">商品名称和默认单价会用于开单</text></view><view class="card form-card"><view class="form-row"><text>商品名称</text><input placeholder="例如 小青龙、冰鲜虾" value="{{name}}" bindinput="onNameInput" /></view><view class="form-row"><text>默认价格</text><input type="digit" placeholder="输入单价" value="{{defaultUnitPrice}}" bindinput="onPriceInput" /></view><view class="form-row"><text>单位</text><input placeholder="斤、件、箱" value="{{unit}}" bindinput="onUnitInput" /></view><view class="form-row"><text>分类</text><picker range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="onCategoryChange"><view class="picker-value">{{categoryNames[categoryIndex]}} <text>›</text></view></picker></view></view><button class="btn-primary save-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="save">添加商品</button></view>
