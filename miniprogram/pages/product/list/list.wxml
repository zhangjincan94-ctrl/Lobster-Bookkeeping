<view class="page product-page"><view class="page-head"><view><text class="page-title">{{selectMode ? '选择商品' : '商品库'}}</text><text class="page-subtitle">商品和分类由你自己定义</text></view><view class="page-actions"><text class="add-link" bindtap="openProduct">+ 添加</text><text wx:if="{{!selectMode}}" class="add-link" bindtap="toggleEdit">{{editMode ? '完成' : '编辑'}}</text></view></view><view class="toolbar"><input placeholder="搜索商品" value="{{keyword}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearch" /><text bindtap="onSearch">搜索</text><text class="category-link" bindtap="openCategory">分类管理</text></view><view wx:if="{{loading}}" class="loading-tip">正在加载商品...</view><view wx:elif="{{!products.length}}" class="empty-state"><text class="empty-icon">◇</text><text class="empty-text">商品库为空，先添加一个商品</text><button class="btn-primary empty-action" bindtap="openProduct">添加商品</button></view><view wx:else><view wx:for="{{products}}" wx:key="id" class="product-row" data-index="{{index}}" bindtap="selectProduct"><view><text class="product-name">{{item.name}}</text><text class="product-meta">{{item.categoryName || '未分类'}} · {{item.unit}} · {{item.defaultUnitPrice === null ? '默认价待定' : '¥' + item.defaultUnitPrice}}</text></view><text wx:if="{{editMode}}" class="archive-link" data-id="{{item.id}}" bindtap="removeProduct">删除</text><text wx:if="{{selectMode}}" class="select-link">选择 ›</text></view></view></view>
<view wx:if="{{showCategory}}" class="modal-mask" bindtap="closeCategory"><view class="dialog" catchtap="noop"><text class="dialog-title">商品分类</text><view class="category-add"><input class="dialog-input" placeholder="新增分类名称" value="{{categoryName}}" bindinput="onCategoryName" /><button class="btn-secondary category-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="saveCategory">新增</button></view><scroll-view class="category-list" scroll-y><view wx:for="{{categories}}" wx:key="id" class="category-row"><text>{{item.name}}</text><text class="archive-link" data-id="{{item.id}}" bindtap="removeCategory">删除</text></view><view wx:if="{{!categories.length}}" class="inline-empty">还没有分类</view></scroll-view><button class="btn-primary close-btn" bindtap="closeCategory">完成</button></view></view>
