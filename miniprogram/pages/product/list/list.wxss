.product-page {
  padding: 24rpx;
}

.page-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin: 4rpx 0 24rpx;
}

.page-head-main {
  min-width: 0;
}

.page-title {
  display: block;
  color: var(--text);
  font-size: 40rpx;
  font-weight: 700;
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: 23rpx;
}

.page-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 22rpx;
  padding-bottom: 4rpx;
}

.action-link,
.select-link {
  color: var(--primary);
  font-size: 25rpx;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
  padding: 0 16rpx 0 20rpx;
  border: 1rpx solid var(--border-strong);
  border-radius: 8rpx;
  background: var(--surface);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  color: var(--text);
  font-size: 26rpx;
}

.search-placeholder {
  color: var(--text-faint);
}

.search-btn {
  flex: 0 0 auto;
  padding: 10rpx 22rpx;
  border-radius: 6rpx;
  background: var(--primary-weak);
  color: var(--primary);
  font-size: 23rpx;
}

.load-summary {
  display: block;
  margin-bottom: 14rpx;
  color: var(--text-muted);
  font-size: 22rpx;
}

.product-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 100rpx;
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  background: var(--surface);
  box-sizing: border-box;
}

.product-main {
  flex: 1;
  min-width: 0;
}

.product-name {
  display: block;
  overflow: hidden;
  color: var(--text);
  font-size: 29rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-meta {
  display: block;
  margin-top: 7rpx;
  color: var(--text-muted);
  font-size: 21rpx;
}

.archive-link {
  flex: 0 0 auto;
  color: var(--sale);
  font-size: 23rpx;
}

.empty-action {
  width: 260rpx;
  margin-top: 28rpx;
}

/* 分类管理弹窗：跟随当前主题，避免弹窗里还是奶油色 */
.dialog {
  display: flex;
  flex-direction: column;
  width: 640rpx;
  max-height: 80vh;
  padding: 28rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border-strong);
  border-radius: 12rpx;
  background: var(--surface);
}

.dialog-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.dialog-head-main {
  min-width: 0;
}

.dialog-title {
  display: block;
  color: var(--text);
  font-size: 32rpx;
  font-weight: 700;
}

.dialog-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: 22rpx;
}

.dialog-close {
  flex: 0 0 auto;
  padding: 0 4rpx;
  color: var(--text-faint);
  font-size: 30rpx;
  line-height: 1.1;
}

.category-add {
  display: flex;
  gap: 12rpx;
}

.dialog-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border-strong);
  border-radius: 6rpx;
  background: var(--surface-2);
  color: var(--text);
  font-size: 26rpx;
}

.dialog-placeholder {
  color: var(--text-faint);
}

.category-btn {
  flex: 0 0 auto;
  width: 148rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  font-size: 24rpx;
  line-height: 76rpx;
}

.category-list {
  margin: 8rpx 0 4rpx;
}

.category-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  border-bottom: 1rpx solid var(--border);
  color: var(--text);
  font-size: 26rpx;
}

.category-del {
  padding: 8rpx 14rpx;
  border-radius: 5rpx;
  background: var(--sale-weak);
  color: var(--sale);
  font-size: 22rpx;
}

.category-count {
  color: var(--text-faint);
  font-size: 22rpx;
}

.inline-empty {
  padding: 36rpx 0;
  color: var(--text-muted);
  font-size: 24rpx;
  text-align: center;
}

.dialog-foot {
  margin-top: 20rpx;
}

.dialog-count {
  display: block;
  margin-bottom: 14rpx;
  color: var(--text-faint);
  font-size: 21rpx;
  text-align: center;
}

.dialog-done {
  width: 100%;
  padding: 20rpx 0;
  font-size: 27rpx;
}
