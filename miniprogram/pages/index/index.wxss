.greeting-section {
  display: flex;
  align-items: center;
  min-height: 74rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #294142;
}

.greeting-text {
  color: #f2f7f5;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.today-card {
  position: relative;
  overflow: hidden;
  padding: 28rpx 24rpx 22rpx;
  border-color: #3c6867;
  background-color: #122526;
}

.today-card::before {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 2rpx;
  background-color: #5de6dc;
  content: "";
}

.today-net {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0 0 24rpx;
  border-bottom: 1rpx solid #294142;
}

.today-net-label,
.cell-label,
.section-title {
  color: #a1b2b0;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.today-net-value {
  margin-top: 8rpx;
  color: #5de6dc;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.today-grid {
  display: flex;
  padding-top: 20rpx;
}

.today-cell {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding: 0 12rpx;
  border-right: 1rpx solid #294142;
}

.today-cell:first-child {
  padding-left: 0;
}

.today-cell:last-child {
  padding-right: 0;
  border-right: none;
}

.cell-value {
  overflow: hidden;
  margin-top: 8rpx;
  color: #f2f7f5 !important;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 27rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell-sub {
  overflow: hidden;
  margin-top: 6rpx;
  color: #718381 !important;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-actions {
  display: flex;
  padding: 0;
  border: none;
  background: transparent;
}

.actions-row {
  display: flex;
  width: 100%;
}

.actions-row-2 .action-big {
  flex: 1;
}

.actions-row-2 .action-big + .action-big {
  margin-left: 16rpx;
}

.action-big {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 164rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border: 1rpx solid #294142;
  border-radius: 8rpx;
  background-color: #122526;
}

.action-sale {
  border-color: rgba(255, 98, 70, 0.65);
  background-color: rgba(255, 98, 70, 0.09);
}

.action-purchase {
  border-color: rgba(93, 230, 220, 0.56);
  background-color: rgba(0, 169, 165, 0.1);
}

.action-big-icon {
  margin-bottom: 12rpx;
  color: #5de6dc;
  font-size: 42rpx;
  line-height: 1;
}

.action-sale .action-big-icon {
  color: #ff765e;
}

.action-big-label {
  color: #f2f7f5;
  font-size: 28rpx;
  font-weight: 700;
}

.other-cost-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-style: dashed;
  border-color: rgba(231, 180, 71, 0.55);
  background-color: rgba(231, 180, 71, 0.06);
}

.other-cost-title {
  display: block;
  color: #f2f7f5;
  font-size: 28rpx;
  font-weight: 700;
}

.other-cost-sub {
  display: block;
  margin-top: 6rpx;
  color: #a1b2b0;
  font-size: 22rpx;
}

.other-cost-action {
  color: #e7b447;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 24rpx;
  font-weight: 700;
}

.reminder-section {
  padding: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.reminder-grid {
  display: flex;
  flex-direction: column;
}

.reminder-item {
  display: flex;
  align-items: center;
  min-height: 80rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #294142;
}

.reminder-item:last-child {
  border-bottom: none;
}

.reminder-label {
  flex: 1;
  color: #f2f7f5;
  font-size: 27rpx;
}

.reminder-value {
  color: #f2f7f5;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 30rpx;
  font-weight: 700;
}

.reminder-sub {
  margin-left: 12rpx;
  color: #718381;
  font-size: 20rpx;
}

.modal-mask {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.cost-modal {
  padding: 28rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 12rpx 12rpx 0 0;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.modal-title {
  color: #f2f7f5;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 30rpx;
  font-weight: 700;
}

.modal-close {
  padding: 0 8rpx;
  color: #a1b2b0;
  font-size: 40rpx;
}

.type-tabs {
  display: flex;
  margin-bottom: 20rpx;
}

.type-tab {
  flex: 1;
  height: 72rpx;
  margin-right: 12rpx;
  border: 1rpx solid #294142;
  border-radius: 4rpx;
  color: #a1b2b0;
  font-size: 26rpx;
  line-height: 72rpx;
  text-align: center;
}

.type-tab:last-child {
  margin-right: 0;
}

.type-tab-active {
  border-color: #5de6dc;
  background-color: rgba(93, 230, 220, 0.1);
  color: #5de6dc;
}

.form-row {
  margin-bottom: 16rpx;
}

.form-label {
  display: block;
  margin-bottom: 8rpx;
  color: #a1b2b0;
  font-size: 22rpx;
}

.form-input,
.form-picker {
  height: 80rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid #294142;
  border-radius: 4rpx;
  background-color: #0b1e1f;
  color: #f2f7f5;
  font-size: 28rpx;
  line-height: 78rpx;
}

.cost-hint {
  margin-bottom: 20rpx;
  color: #718381;
  font-size: 22rpx;
  line-height: 1.55;
}

.save-cost-btn {
  width: 100%;
  height: 84rpx;
  color: #002b2a;
  font-size: 28rpx;
  line-height: 82rpx;
}
