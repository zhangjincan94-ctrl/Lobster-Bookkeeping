<view class="login-page">
  <view class="login-container">
    <view class="logo-area">
      <image class="logo-icon" src="/assets/lobster-accounting-avatar-144.png" mode="aspectFill" />
      <text class="logo-text">龙虾记账</text>
    </view>
    <text class="subtitle">轻松记账，高效管理</text>
    <button
      class="login-btn"
      bindtap="onLogin"
      loading="{{loading}}"
      disabled="{{loading}}"
    >
      微信一键登录
    </button>
    <text class="terms-text">登录即同意用户协议和隐私政策</text>
  </view>
</view>
