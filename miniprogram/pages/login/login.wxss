.login-page {
  position: relative;
  display: flex;
  min-height: 100vh;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background-color: var(--bg);
}

.login-page::before,
.login-page::after {
  position: absolute;
  content: "";
}

.login-page::before {
  top: 0;
  right: 0;
  left: 0;
  height: 2rpx;
  background-color: var(--primary);
  box-shadow: 0 0 16rpx rgba(var(--primary-rgb), 0.6);
}

.login-page::after {
  right: 48rpx;
  bottom: 120rpx;
  width: 96rpx;
  height: 96rpx;
  border-right: 1rpx solid var(--border);
  border-bottom: 1rpx solid var(--border);
}

.login-container {
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
  padding: 48rpx 48rpx 88rpx;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-icon {
  width: 144rpx;
  height: 144rpx;
  overflow: hidden;
  border: 1rpx solid var(--primary);
  border-radius: 12rpx;
  box-shadow: 0 0 24rpx rgba(var(--primary-rgb), 0.2);
}

.logo-text {
  margin-top: 28rpx;
  color: var(--text);
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.subtitle {
  display: block;
  margin-top: 14rpx;
  color: var(--text-muted);
  font-size: 26rpx;
  text-align: center;
}

.login-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 88rpx;
  border: 1rpx solid var(--primary);
  border-radius: 6rpx;
  background-color: var(--primary);
  color: var(--on-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 90rpx;
  box-shadow: 0 0 22rpx rgba(var(--primary-rgb), 0.18);
}

.login-btn[disabled] {
  border-color: var(--border-strong);
  background-color: var(--border-strong);
  color: var(--text-faint);
  box-shadow: none;
}

.terms-text {
  display: block;
  margin-top: 28rpx;
  color: var(--text-faint);
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}
