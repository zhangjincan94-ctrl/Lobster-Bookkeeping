.login-page {
  position: relative;
  display: flex;
  min-height: 100vh;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background-color: #0b1617;
  background-image: linear-gradient(rgba(41, 65, 66, 0.18) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(41, 65, 66, 0.18) 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
}

.login-page::before,
.login-page::after {
  position: absolute;
  content: "";
}

.login-page::before {
  top: 0;
  right: 0;
  left: 0;
  height: 2rpx;
  background-color: #5de6dc;
  box-shadow: 0 0 16rpx rgba(93, 230, 220, 0.6);
}

.login-page::after {
  right: 48rpx;
  bottom: 120rpx;
  width: 96rpx;
  height: 96rpx;
  border-right: 1rpx solid #294142;
  border-bottom: 1rpx solid #294142;
}

.login-container {
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
  padding: 48rpx 48rpx 88rpx;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-icon {
  width: 144rpx;
  height: 144rpx;
  overflow: hidden;
  border: 1rpx solid #5de6dc;
  border-radius: 12rpx;
  box-shadow: 0 0 24rpx rgba(93, 230, 220, 0.2);
}

.logo-text {
  margin-top: 28rpx;
  color: #f2f7f5;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.subtitle {
  display: block;
  margin-top: 14rpx;
  color: #a1b2b0;
  font-size: 26rpx;
  text-align: center;
}

.login-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 88rpx;
  border: 1rpx solid #5de6dc;
  border-radius: 6rpx;
  background-color: #00a9a5;
  color: #002b2a;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 90rpx;
  box-shadow: 0 0 22rpx rgba(93, 230, 220, 0.18);
}

.login-btn[disabled] {
  border-color: #435756;
  background-color: #435756;
  color: #9eaeac;
  box-shadow: none;
}

.terms-text {
  display: block;
  margin-top: 28rpx;
  color: #718381;
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}
