.page { min-height: 100vh; padding: 24rpx; }
.header { position: relative; display: flex; align-items: center; padding: 26rpx 22rpx; border: 1rpx solid #3c6867; border-radius: 6rpx; background-color: #122526; }
.header::before { position: absolute; top: 0; left: 0; width: 100%; height: 2rpx; background-color: #5de6dc; content: ""; }
.avatar { display: flex; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; margin-right: 18rpx; border: 1rpx solid #5de6dc; border-radius: 6rpx; background-color: #0b1e1f; font-size: 38rpx; }
.header-info { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.shop-name { overflow: hidden; color: #f2f7f5; font-size: 31rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.phone { margin-top: 7rpx; color: #a1b2b0; font-family: "SFMono-Regular", Consolas, monospace; font-size: 21rpx; }
.menu-card { margin-top: 16rpx; margin-bottom: 0; padding: 0 20rpx; border: 1rpx solid #294142; border-radius: 6rpx; background-color: #122526; }
.menu-title { padding: 20rpx 0 12rpx; border-bottom: 1rpx solid #294142; color: #5de6dc; font-family: "SFMono-Regular", Consolas, monospace; font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }
.menu-item { display: flex; align-items: center; justify-content: space-between; min-height: 86rpx; border-bottom: 1rpx solid #21393a; }
.menu-item:last-child { border-bottom: none; }
.menu-label { color: #f2f7f5; font-size: 27rpx; }
.menu-right { display: flex; align-items: center; min-width: 0; margin-left: 20rpx; }
.menu-value { overflow: hidden; max-width: 250rpx; color: #a1b2b0; font-size: 23rpx; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.menu-arrow { margin-left: 12rpx; color: #5de6dc; font-size: 30rpx; }
.modal-mask { position: fixed; z-index: 200; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; }
.modal-content { width: 630rpx; overflow: hidden; border-radius: 8rpx; }
.modal-title { padding: 26rpx 24rpx 14rpx; color: #f2f7f5; font-family: "SFMono-Regular", Consolas, monospace; font-size: 29rpx; font-weight: 700; text-align: center; }
.modal-body { padding: 10rpx 24rpx 20rpx; }
.modal-input { width: 100%; height: 70rpx; box-sizing: border-box; padding: 0 14rpx; border: 1rpx solid #294142; border-radius: 4rpx; background-color: #0b1e1f; color: #f2f7f5; font-size: 26rpx; line-height: 70rpx; }
.modal-actions { display: flex; border-top: 1rpx solid #294142; }
.modal-btn { flex: 1; padding: 22rpx 0; border-radius: 0; font-size: 27rpx; }
.modal-btn-cancel { border-right: 1rpx solid #294142; }
