<view class="page theme-{{theme}}">
  <view class="header">
    <view class="avatar" bindtap="onChooseAvatar">
      <image class="avatar-img" src="{{avatar || '/assets/miniprogram-avatar-144.png'}}" mode="aspectFill" />
      <text class="avatar-badge">+</text>
    </view>
    <view class="header-info">
      <text class="shop-name">{{shopName}}</text>
      <text class="phone text-muted">{{phone || '未设置联系电话'}}</text>
    </view>
  </view>

  <view class="menu-card card">
    <view class="menu-title">店铺设置</view>
    <view class="menu-item" bindtap="onEditShop">
      <text class="menu-label">店铺名称</text>
      <view class="menu-right">
        <text class="menu-value text-muted">{{shopName}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onEditPhone">
      <text class="menu-label">联系电话</text>
      <view class="menu-right">
        <text class="menu-value text-muted">{{phone || '未设置'}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="menu-card card">
    <view class="menu-title">商品设置</view>
    <view class="menu-item" bindtap="goProductLibrary">
      <text class="menu-label">商品库</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-card card">
    <view class="menu-title">经营分析</view>
    <view class="menu-item" bindtap="goTradeStats">
      <text class="menu-label">交易统计</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goExport">
      <text class="menu-label">导出账单</text>
      <view class="menu-right">
        <text class="menu-value text-muted">Excel</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="menu-card card">
    <view class="menu-title">外观</view>
    <view class="menu-item" bindtap="goTheme">
      <text class="menu-label">主题外观</text>
      <view class="menu-right">
        <text class="menu-value text-muted">{{themeName}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="menu-card card">
    <view class="menu-item" bindtap="onLogout">
      <text class="menu-label text-danger">退出登录</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
  <canvas type="2d" id="avatarCanvas" class="avatar-canvas"></canvas>
</view>

<view class="modal-mask" wx:if="{{showEditModal}}" bindtap="onCloseEditModal">
  <view class="modal-content" catchtap="noop">
    <view class="modal-title">{{editTitle}}</view>
    <view class="modal-body">
      <input
        class="modal-input"
        placeholder="{{editPlaceholder}}"
        value="{{editValue}}"
        bindinput="onEditInput"
        focus="{{showEditModal}}"
        cursor-spacing="80"
      />
    </view>
    <view class="modal-actions">
      <button class="modal-btn modal-btn-cancel" bindtap="onCloseEditModal">取消</button>
      <button class="modal-btn modal-btn-confirm" bindtap="onEditSubmit" loading="{{submitting}}" disabled="{{submitting}}">保存</button>
    </view>
  </view>
</view>
