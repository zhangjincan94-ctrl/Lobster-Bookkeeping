<view class="page statement-page"><view wx:if="{{loading}}" class="loading-tip">正在加载结账信息...</view><view wx:elif="{{statement}}"><view class="statement-head"><text class="eyebrow">只读结账信息</text><text class="customer">{{statement.customer.name}}</text><text class="period">{{statement.startDate}} 至 {{statement.endDate}}</text><text class="balance-label">{{statement.balanceLabel}}</text><text class="balance">{{statement.balanceDisplay}}</text></view><view class="summary card"><view><text>出货账额</text><text class="sale">{{statement.salesDisplay}}</text></view><view><text>进货账额</text><text class="purchase">{{statement.purchaseDisplay}}</text></view><view><text>已回款</text><text class="received">{{statement.receivedDisplay}}</text></view></view><view class="card"><text class="section-title">账单明细（{{statement.billCount}} 笔）</text><view wx:if="{{!statement.bills.length}}" class="empty-inline">该账期没有账单</view><view wx:for="{{statement.bills}}" wx:key="id" class="line"><view><text class="tag {{item.directionClass}}">{{item.directionText}}</text><text class="date">{{item.billDate}}</text></view><text class="amount {{item.directionClass}}">{{item.totalDisplay}}</text></view></view><view wx:if="{{statement.payments.length}}" class="card"><text class="section-title">回款明细</text><view wx:for="{{statement.payments}}" wx:key="id" class="line"><view><text class="tag received">回款</text><text class="date">{{item.paymentDate}}</text></view><text class="amount received">{{item.amountDisplay}}</text></view></view><button class="share-button" open-type="share">分享结账信息</button></view><view wx:else class="empty-state"><text class="empty-text">结账信息不存在或已失效</text></view></view>
