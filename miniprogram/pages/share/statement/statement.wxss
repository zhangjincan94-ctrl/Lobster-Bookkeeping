.statement-page { padding: 24rpx 24rpx 52rpx; }.statement-head { padding: 30rpx; border: 1rpx solid #3c6867; border-radius: 7rpx; background: #122526; }.eyebrow { display: block; color: #5de6dc; font-size: 21rpx; }.customer { display: block; margin-top: 12rpx; color: #f2f7f5; font-size: 42rpx; font-weight: 700; }.period { display: block; margin-top: 10rpx; color: #a1b2b0; font-size: 23rpx; }.balance-label { display: block; margin-top: 26rpx; color: #a1b2b0; font-size: 22rpx; }.balance { display: block; margin-top: 8rpx; color: #5de6dc; font-size: 48rpx; font-weight: 700; }.summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; text-align: center; }.summary view { min-width: 0; }.summary text { display: block; color: #a1b2b0; font-size: 20rpx; }.summary text + text { margin-top: 10rpx; font-size: 24rpx; font-weight: 700; }.sale { color: #ff967f !important; }.purchase { color: #f2ca72 !important; }.received { color: #4bce91 !important; }.section-title { display: block; margin-bottom: 14rpx; color: #f2f7f5; font-weight: 600; }.line { display: flex; align-items: center; justify-content: space-between; min-height: 78rpx; border-top: 1rpx solid #294142; }.tag { display: inline-block; padding: 3rpx 9rpx; border-radius: 4rpx; font-size: 20rpx; }.tag.sale { color: #ff967f !important; background: rgba(255, 98, 70, .1); }.tag.purchase { color: #f2ca72 !important; background: rgba(231, 180, 71, .1); }.tag.received { color: #4bce91 !important; background: rgba(75, 206, 145, .1); }.date { margin-left: 10rpx; color: #a1b2b0; font-size: 22rpx; }.amount { font-weight: 600; }.empty-inline { padding: 30rpx 0; color: #a1b2b0; text-align: center; }.share-button { margin-top: 10rpx; background: #00a9a5; border: 1rpx solid #5de6dc; border-radius: 6rpx; color: #002b2a; }
