.statement-page { padding: 24rpx 24rpx 52rpx; }.statement-head { padding: 30rpx; border: 1rpx solid var(--border-strong); border-radius: 7rpx; background: var(--surface); }.eyebrow { display: block; color: var(--primary); font-size: 21rpx; }.customer { display: block; margin-top: 12rpx; color: var(--text); font-size: 42rpx; font-weight: 700; }.period { display: block; margin-top: 10rpx; color: var(--text-muted); font-size: 23rpx; }.statement-balances { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 26rpx; }.statement-balances view { min-width: 0; padding: 16rpx; border: 1rpx solid var(--border); background: var(--surface-2); }.statement-balances text { display: block; color: var(--text-muted); font-size: 21rpx; }.statement-balances text + text { margin-top: 8rpx; font-size: 32rpx; font-weight: 700; }.summary { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx 10rpx; text-align: center; }.summary view { min-width: 0; }.summary text { display: block; color: var(--text-muted); font-size: 20rpx; }.summary text + text { margin-top: 10rpx; font-size: 24rpx; font-weight: 700; }.sale { color: var(--sale) !important; }.purchase, .paid, .payable { color: var(--warn) !important; }.received { color: var(--purchase) !important; }.receivable { color: var(--sale) !important; }.section-title { display: block; margin-bottom: 14rpx; color: var(--text); font-weight: 600; }.line { display: flex; align-items: center; justify-content: space-between; min-height: 78rpx; border-top: 1rpx solid var(--border); }.tag { display: inline-block; padding: 3rpx 9rpx; border-radius: 4rpx; font-size: 20rpx; }.tag.sale { color: var(--sale) !important; background: rgba(var(--sale-rgb), .1); }.tag.purchase, .tag.paid { color: var(--warn) !important; background: rgba(var(--warn-rgb), .1); }.tag.received { color: var(--purchase) !important; background: rgba(var(--purchase-rgb), .1); }.date { margin-left: 10rpx; color: var(--text-muted); font-size: 22rpx; }.amount { font-weight: 600; }.amount.paid { color: var(--warn); }.amount.received { color: var(--purchase); }.empty-inline { padding: 30rpx 0; color: var(--text-muted); text-align: center; }.share-button { margin-top: 10rpx; background: var(--primary); border: 1rpx solid var(--primary); border-radius: 6rpx; color: var(--on-primary); }
