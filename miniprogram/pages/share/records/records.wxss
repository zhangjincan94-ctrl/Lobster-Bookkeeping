.page {
  min-height: 100vh;
  padding: 24rpx;
}

.buyer-card,
.stats-card,
.transaction-item {
  border: 1rpx solid #294142;
  border-radius: 6rpx;
  background-color: #122526;
}

.buyer-card {
  position: relative;
  overflow: hidden;
  padding: 24rpx;
  border-color: #3c6867;
}

.buyer-card::before {
  display: block;
  margin-bottom: 12rpx;
  color: #5de6dc;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 19rpx;
  letter-spacing: 2rpx;
  content: "BUYER STATEMENT";
}

.buyer-name {
  display: block;
  color: #f2f7f5;
  font-size: 34rpx;
  font-weight: 700;
}

.buyer-phone {
  display: block;
  margin-top: 8rpx;
  color: #a1b2b0;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 22rpx;
}

.stats-card {
  display: flex;
  margin-top: 16rpx;
  overflow: hidden;
}

.stats-row {
  display: flex;
  width: 100%;
}

.stats-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding: 22rpx 18rpx;
}

.stats-item + .stats-item {
  border-left: 1rpx solid #294142;
}

.stats-value {
  overflow: hidden;
  color: #f2f7f5;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats-label {
  margin-top: 8rpx;
  color: #a1b2b0;
  font-size: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  margin-bottom: 14rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #294142;
}

.section-title {
  color: #5de6dc;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 21rpx;
  letter-spacing: 2rpx;
}

.transaction-list {
  display: flex;
  flex-direction: column;
}

.transaction-item {
  margin-bottom: 12rpx;
  padding: 20rpx;
  border-left: 3rpx solid #5de6dc;
}

.transaction-top,
.transaction-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.transaction-left {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-right: 16rpx;
}

.transaction-type {
  color: #f2f7f5;
  font-size: 26rpx;
  font-weight: 700;
}

.transaction-sub,
.transaction-time {
  margin-top: 6rpx;
  color: #a1b2b0;
  font-size: 20rpx;
}

.transaction-amount {
  color: #f2f7f5;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 28rpx;
  font-weight: 700;
}

.transaction-bottom {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed #294142;
}
